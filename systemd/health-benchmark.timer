# Installed by install-health-benchmark.sh, which overwrites edits made here.
#
# Starts health-benchmark.service once a day at 04:00, when no other scheduled job runs: e2scrub_all runs on Sundays
# at 03:10 and finishes within seconds, cron.hourly at minute 17 is empty, anacron runs the daily cron jobs from 05:00
# on (anacron.timer.d/50-start-at-5.conf), apt-daily-upgrade from 06:00, and logrotate and the dpkg and sysstat jobs
# around midnight. apt-daily, man-db, fwupd-refresh, ua-timer and motd-news start at random times of the day and
# cannot be avoided this way.
#
# A day on which the laptop is suspended or off at 04:00 is skipped rather than made up later, because later the
# laptop is likely in use. Persistent=false keeps a boot from starting a measurement missed while the laptop was off.
# A timer which elapses during suspend still starts the service on resume, so health-benchmark --scheduled skips a
# start later than 04:05. Its SCHEDULED_AT has to match OnCalendar.

[Unit]
Description=Measure cooling, processor performance and battery ageing once a day

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=false

[Install]
WantedBy=timers.target
