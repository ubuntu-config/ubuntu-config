Description: Pass an activation token from a GTK 4 window when opening a URI, a file or a directory.
 The OpenURI portal accepts an activation token since version 4 of its interface, and xdg-desktop-portal passes it
 to the application it launches, in XDG_ACTIVATION_TOKEN and DESKTOP_STARTUP_ID or in the platform data of its D-Bus
 activation, so that the compositor can focus the window the application opens. xdp_portal_open_uri() and
 xdp_portal_open_directory() sent none, so a link opened from an application using libportal, such as Ptyxis,
 reached the browser without one, and on Wayland the browser's window was focused only as a newly mapped window,
 also when the user had already clicked or typed elsewhere.
 .
 XdpParent receives an optional function which requests an activation token for its window and passes it to a
 callback, which xdp_parent_new_gtk() of the GTK 4 helper sets, requesting the token from GDK's application launch
 context, as GTK's own OpenURI portal client does. xdp_portal_open_uri() and xdp_portal_open_directory() request it
 first, while the user's action is the latest input to the window, and add it to the options of the request as
 activation_token. Applications need no change.
Author: Mitar
Forwarded: https://github.com/flatpak/libportal/pull/236
Last-Update: 2026-11-09
diff --git a/libportal/openuri.c b/libportal/openuri.c
index a1116de..5ced601 100644
--- a/libportal/openuri.c
+++ b/libportal/openuri.c
@@ -36,6 +36,7 @@ typedef struct {
   XdpPortal *portal;
   XdpParent *parent;
   char *parent_handle;
+  char *activation_token;
   char *uri;
   gboolean ask;
   gboolean writable;
@@ -55,6 +56,7 @@ open_call_free (OpenCall *call)
       xdp_parent_free (call->parent);
     }
   g_free (call->parent_handle);
+  g_free (call->activation_token);
 
   if (call->signal_id)
     g_dbus_connection_signal_unsubscribe (call->portal->bus, call->signal_id);
@@ -99,6 +101,34 @@ response_received (GDBusConnection *bus,
 
 static void do_open (OpenCall *call);
 
+static void
+activation_token_ready (G_GNUC_UNUSED XdpParent *parent,
+                        const char              *token,
+                        gpointer                 data)
+{
+  OpenCall *call = data;
+
+  call->activation_token = g_strdup (token);
+  do_open (call);
+}
+
+/* Requests an activation token for the application which handles the request,
+ * from the window the request is made for, and then makes the request. The
+ * token has to be requested while the user's action which made the request is
+ * the latest input to the window, so it is requested first, before the window
+ * is exported. A toolkit which cannot provide a token passes NULL. */
+static void
+open_with_activation_token (OpenCall *call)
+{
+  if (call->parent == NULL || call->parent->parent_activation_token == NULL)
+    {
+      do_open (call);
+      return;
+    }
+
+  call->parent->parent_activation_token (call->parent, activation_token_ready, call);
+}
+
 static void
 parent_exported (XdpParent *parent,
                  const char *handle,
@@ -194,6 +224,8 @@ do_open (OpenCall *call)
   g_variant_builder_add (&options, "{sv}", "handle_token", g_variant_new_string (token));
   g_variant_builder_add (&options, "{sv}", "writable", g_variant_new_boolean (call->writable));
   g_variant_builder_add (&options, "{sv}", "ask", g_variant_new_boolean (call->ask));
+  if (call->activation_token)
+    g_variant_builder_add (&options, "{sv}", "activation_token", g_variant_new_string (call->activation_token));
 
   file = g_file_new_for_uri (call->uri);
 
@@ -267,6 +299,10 @@ do_open (OpenCall *call)
  * @data: data to pass to @callback
  *
  * Opens @uri with an external handler.
+ *
+ * When @parent was created from a window with one of the toolkit helpers, the
+ * request carries an activation token from that window, if the toolkit
+ * provides one, so that the compositor can focus the handler's window.
  */
 void
 xdp_portal_open_uri (XdpPortal *portal,
@@ -296,7 +332,7 @@ xdp_portal_open_uri (XdpPortal *portal,
   call->task = g_task_new (portal, cancellable, callback, data);
   g_task_set_source_tag (call->task, xdp_portal_open_uri);
 
-  do_open (call);
+  open_with_activation_token (call);
 }
 
 /**
@@ -337,6 +373,10 @@ xdp_portal_open_uri_finish (XdpPortal *portal,
  *
  * which must be a file: uri pointing to a file that the application has access
  * to.
+ *
+ * When @parent was created from a window with one of the toolkit helpers, the
+ * request carries an activation token from that window, if the toolkit
+ * provides one, so that the compositor can focus the file manager's window.
  */
 void
 xdp_portal_open_directory (XdpPortal *portal,
@@ -365,7 +405,7 @@ xdp_portal_open_directory (XdpPortal *portal,
   call->task = g_task_new (portal, cancellable, callback, data);
   g_task_set_source_tag (call->task, xdp_portal_open_directory);
 
-  do_open (call);
+  open_with_activation_token (call);
 }
 
 /**
diff --git a/libportal/parent-private.h b/libportal/parent-private.h
index 7d1385d..2d66c99 100644
--- a/libportal/parent-private.h
+++ b/libportal/parent-private.h
@@ -30,11 +30,18 @@ typedef gboolean (* XdpParentExport)   (XdpParent         *parent,
                                         XdpParentExported  callback,
                                         gpointer           data);
 typedef void     (* XdpParentUnexport) (XdpParent         *parent);
+typedef void     (* XdpParentActivationTokenReady) (XdpParent  *parent,
+                                                    const char *token,
+                                                    gpointer    data);
+typedef void     (* XdpParentActivationToken) (XdpParent                     *parent,
+                                               XdpParentActivationTokenReady  callback,
+                                               gpointer                       data);
 
 struct _XdpParent {
   /*< private >*/
   XdpParentExport parent_export;
   XdpParentUnexport parent_unexport;
+  XdpParentActivationToken parent_activation_token;
   GObject *object;
   XdpParentExported callback;
   char *exported_handle;
diff --git a/libportal/parent.c b/libportal/parent.c
index 7c9a2df..f49863f 100644
--- a/libportal/parent.c
+++ b/libportal/parent.c
@@ -51,6 +51,7 @@ xdp_parent_copy (XdpParent *source)
 
   parent->parent_export = source->parent_export;
   parent->parent_unexport = source->parent_unexport;
+  parent->parent_activation_token = source->parent_activation_token;
   g_set_object (&parent->object, source->object);
   parent->data = source->data;
   parent->exported_handle = g_strdup (source->exported_handle);
diff --git a/libportal/portal-gtk4.c b/libportal/portal-gtk4.c
index 30331af..fdf4304 100644
--- a/libportal/portal-gtk4.c
+++ b/libportal/portal-gtk4.c
@@ -96,6 +96,25 @@ _xdp_parent_unexport_gtk (XdpParent *parent)
 #endif
 }
 
+static void
+_xdp_parent_activation_token_gtk (XdpParent                     *parent,
+                                  XdpParentActivationTokenReady  callback,
+                                  gpointer                       data)
+{
+  g_autofree char *token = NULL;
+
+  /* GLib accepts a launch context without an application only since 2.82 */
+#if GLIB_CHECK_VERSION (2, 82, 0)
+  GdkDisplay *display = gtk_widget_get_display (GTK_WIDGET (parent->object));
+  GdkAppLaunchContext *context = gdk_display_get_app_launch_context (display);
+
+  token = g_app_launch_context_get_startup_notify_id (G_APP_LAUNCH_CONTEXT (context), NULL, NULL);
+  g_object_unref (context);
+#endif
+
+  callback (parent, token, data);
+}
+
 /**
  * xdp_parent_new_gtk:
  * @window: a [class@Gtk.Window]
@@ -110,6 +129,7 @@ xdp_parent_new_gtk (GtkWindow *window)
   XdpParent *parent = g_new0 (XdpParent, 1);
   parent->parent_export = _xdp_parent_export_gtk;
   parent->parent_unexport = _xdp_parent_unexport_gtk;
+  parent->parent_activation_token = _xdp_parent_activation_token_gtk;
   parent->object = (GObject *) g_object_ref (window);
   return parent;
 }
