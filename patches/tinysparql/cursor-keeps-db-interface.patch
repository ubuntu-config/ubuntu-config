 static void
+test_tracker_sparql_connection_close_cursor (void)
+{
+	TrackerSparqlConnection *connection;
+	TrackerSparqlCursor *cursor;
+	GError *error = NULL;
+
+	connection = create_local_connection (&error);
+	g_assert_no_error (error);
+
+	cursor = tracker_sparql_connection_query (connection, "ASK {}", NULL, &error);
+	g_assert_no_error (error);
+	g_assert_true (tracker_sparql_cursor_next (cursor, NULL, &error));
+	g_assert_no_error (error);
+	g_assert_false (tracker_sparql_cursor_next (cursor, NULL, &error));
+	g_assert_no_error (error);
+
+	tracker_sparql_connection_close (connection);
+	g_object_unref (cursor);
+	g_object_unref (connection);
+}
