+
+#include "config.h"
+
+#include "meta-test/meta-context-test.h"
+#include "meta/display.h"
+#include "tests/meta-wayland-test-driver.h"
+#include "tests/meta-wayland-test-utils.h"
+
+static MetaContext *test_context;
+static MetaWaylandTestDriver *test_driver;
+
+static void
+gtk_shell_menubar_toggle (void)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  MetaWaylandTestClient *wayland_test_client;
+
+  wayland_test_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "gtk-shell-menubar",
+                                            "toggle",
+                                            NULL);
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, 0);
+
+  meta_display_set_shell_shows_menubar (display, TRUE);
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, 1);
+
+  /* Setting it again sends nothing, otherwise the third event the client
+   * receives has the bit set, which fails its check. */
+  meta_display_set_shell_shows_menubar (display, TRUE);
+  meta_display_set_shell_shows_menubar (display, FALSE);
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, 2);
+
+  meta_wayland_test_client_finish (wayland_test_client);
+}
+
+static void
+gtk_shell_menubar_initially_set (void)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  MetaWaylandTestClient *wayland_test_client;
+
+  meta_display_set_shell_shows_menubar (display, TRUE);
+
+  wayland_test_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "gtk-shell-menubar",
+                                            "initially-set",
+                                            NULL);
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, 0);
+  meta_wayland_test_client_finish (wayland_test_client);
+
+  meta_display_set_shell_shows_menubar (display, FALSE);
+}
+
+static void
+on_before_tests (void)
+{
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (test_context);
+
+  test_driver = meta_wayland_test_driver_new (compositor);
+}
+
+static void
+on_after_tests (void)
+{
+  g_clear_object (&test_driver);
+}
+
+static void
+init_tests (void)
+{
+  g_test_add_func ("/wayland/gtk-shell-menubar/toggle",
+                   gtk_shell_menubar_toggle);
+  g_test_add_func ("/wayland/gtk-shell-menubar/initially-set",
+                   gtk_shell_menubar_initially_set);
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+  g_autoptr (MetaContext) context = NULL;
+
+#ifdef MUTTER_PRIVILEGED_TEST
+  return 0;
+#endif
+
+  context = meta_create_test_context (META_CONTEXT_TEST_TYPE_HEADLESS,
+                                      META_CONTEXT_TEST_FLAG_NO_X11 |
+                                      META_CONTEXT_TEST_FLAG_TEST_CLIENT);
+  g_assert_true (meta_context_configure (context, &argc, &argv, NULL));
+
+  test_context = context;
+
+  init_tests ();
+
+  g_signal_connect (context, "before-tests",
+                    G_CALLBACK (on_before_tests), NULL);
+  g_signal_connect (context, "after-tests",
+                    G_CALLBACK (on_after_tests), NULL);
+
+  return meta_context_test_run_tests (META_CONTEXT_TEST (context),
+                                      META_TEST_RUN_FLAG_NONE);
+}
diff --git a/src/tests/wayland-test-clients/gtk-shell-menubar.c b/src/tests/wayland-test-clients/gtk-shell-menubar.c
new file mode 100644
index 0000000..04c82ad
--- /dev/null
+++ b/src/tests/wayland-test-clients/gtk-shell-menubar.c
@@ -0,0 +1,123 @@
+/*
+ * Copyright (C) 2026 Mitar
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Test client for meta_display_set_shell_shows_menubar(): checks the
+ * GLOBAL_MENU_BAR bit of each gtk_shell1 capabilities event it receives and
+ * reports each event with a sync point. With "toggle" it expects the bit
+ * unset, set and unset again. With "initially-set" it expects the bit set in
+ * the event sent when it binds gtk_shell1.
+ */
+
+#include "config.h"
+
+#include <glib.h>
+#include <wayland-client.h>
+
+#include "wayland-test-client-utils.h"
+
+#include "gtk-shell-client-protocol.h"
+
+static struct gtk_shell1 *gtk_shell;
+static const char *test_name;
+static int capabilities_count;
+static gboolean running;
+
+static void
+gtk_shell_handle_capabilities (void              *data,
+                               struct gtk_shell1 *shell,
+                               uint32_t           capabilities)
+{
+  WaylandDisplay *display = data;
+  gboolean shows_menubar =
+    (capabilities & GTK_SHELL1_CAPABILITY_GLOBAL_MENU_BAR) != 0;
+
+  if (g_strcmp0 (test_name, "toggle") == 0)
+    {
+      g_assert_cmpint (capabilities_count, <, 3);
+      g_assert_true (shows_menubar == (capabilities_count == 1));
+    }
+  else
+    {
+      g_assert_cmpint (capabilities_count, ==, 0);
+      g_assert_true (shows_menubar);
+    }
+
+  test_driver_sync_point (display->test_driver, capabilities_count, NULL);
+  capabilities_count++;
+
+  if (g_strcmp0 (test_name, "toggle") != 0 || capabilities_count == 3)
+    running = FALSE;
+}
+
+static const struct gtk_shell1_listener gtk_shell_listener = {
+  gtk_shell_handle_capabilities,
+};
+
+static void
+handle_registry_global (void               *data,
+                        struct wl_registry *registry,
+                        uint32_t            id,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  WaylandDisplay *display = data;
+
+  if (strcmp (interface, gtk_shell1_interface.name) == 0)
+    {
+      gtk_shell = wl_registry_bind (registry, id, &gtk_shell1_interface, 1);
+      gtk_shell1_add_listener (gtk_shell, &gtk_shell_listener, display);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *data,
+                               struct wl_registry *registry,
+                               uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove
+};
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (WaylandDisplay) display = NULL;
+  struct wl_registry *registry;
+
+  g_assert_cmpint (argc, ==, 2);
+  test_name = argv[1];
+
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, display);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (gtk_shell);
+
+  running = TRUE;
+  while (running)
+    wayland_display_dispatch (display);
+
+  wl_display_roundtrip (display->display);
+
+  return EXIT_SUCCESS;
+}
