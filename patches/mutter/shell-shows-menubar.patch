+/**
+ * meta_display_set_shell_shows_menubar:
+ * @display: a #MetaDisplay
+ * @shows_menubar: whether the shell shows the menu bars of windows
+ *
+ * Sets whether the shell shows the menu bars of windows itself, which
+ * Wayland clients learn from the gtk_shell1 capability GLOBAL_MENU_BAR. GTK
+ * hides the menu bar of a GtkApplicationWindow while it is set, and shows it
+ * again once it is unset. It is unset initially.
+ */
+void
+meta_display_set_shell_shows_menubar (MetaDisplay *display,
+                                      gboolean     shows_menubar)
+{
+  MetaDisplayPrivate *priv;
+  MetaWaylandCompositor *compositor;
+
+  g_return_if_fail (META_IS_DISPLAY (display));
+
+  priv = meta_display_get_instance_private (display);
+  shows_menubar = !!shows_menubar;
+  if (priv->shell_shows_menubar == shows_menubar)
+    return;
+
+  priv->shell_shows_menubar = shows_menubar;
+
+  compositor = meta_context_get_wayland_compositor (priv->context);
+  if (compositor)
+    meta_wayland_gtk_shell_update_capabilities (compositor);
+}
+
+gboolean
+meta_display_get_shell_shows_menubar (MetaDisplay *display)
+{
+  MetaDisplayPrivate *priv = meta_display_get_instance_private (display);
+
+  return priv->shell_shows_menubar;
+}
