diff --git a/src/wayland/meta-wayland-gtk-shell.c b/src/wayland/meta-wayland-gtk-shell.c
index 051e689..82f421c 100644
--- a/src/wayland/meta-wayland-gtk-shell.c
+++ b/src/wayland/meta-wayland-gtk-shell.c
@@ -23,6 +23,7 @@
 #include "wayland/meta-wayland-gtk-shell.h"
 
 #include "core/bell.h"
+#include "core/display-private.h"
 #include "core/window-private.h"
 #include "wayland/meta-wayland-private.h"
 #include "wayland/meta-wayland-surface-private.h"
@@ -639,28 +640,29 @@ meta_wayland_gtk_shell_class_init (MetaWaylandGtkShellClass *klass)
 }
 
 static uint32_t
-calculate_capabilities (void)
+calculate_capabilities (MetaWaylandGtkShell *gtk_shell)
 {
+  MetaContext *context =
+    meta_wayland_compositor_get_context (gtk_shell->compositor);
+  MetaDisplay *display = meta_context_get_display (context);
   uint32_t capabilities = 0;
 
   if (!meta_prefs_get_show_fallback_app_menu ())
     capabilities = GTK_SHELL1_CAPABILITY_GLOBAL_APP_MENU;
 
+  if (display && meta_display_get_shell_shows_menubar (display))
+    capabilities |= GTK_SHELL1_CAPABILITY_GLOBAL_MENU_BAR;
+
   return capabilities;
 }
 
 static void
-prefs_changed (MetaPreference pref,
-               gpointer       user_data)
+update_capabilities (MetaWaylandGtkShell *gtk_shell)
 {
-  MetaWaylandGtkShell *gtk_shell = user_data;
   uint32_t new_capabilities;
   GList *l;
 
-  if (pref != META_PREF_BUTTON_LAYOUT)
-    return;
-
-  new_capabilities = calculate_capabilities ();
+  new_capabilities = calculate_capabilities (gtk_shell);
   if (gtk_shell->capabilities == new_capabilities)
     return;
   gtk_shell->capabilities = new_capabilities;
@@ -673,6 +675,18 @@ prefs_changed (MetaPreference pref,
     }
 }
 
+static void
+prefs_changed (MetaPreference pref,
+               gpointer       user_data)
+{
+  MetaWaylandGtkShell *gtk_shell = user_data;
+
+  if (pref != META_PREF_BUTTON_LAYOUT)
+    return;
+
+  update_capabilities (gtk_shell);
+}
+
 static MetaWaylandGtkShell *
 meta_wayland_gtk_shell_new (MetaWaylandCompositor *compositor)
 {
@@ -687,7 +701,7 @@ meta_wayland_gtk_shell_new (MetaWaylandCompositor *compositor)
     g_error ("Failed to register a global gtk-shell object");
 
   gtk_shell->compositor = compositor;
-  gtk_shell->capabilities = calculate_capabilities ();
+  gtk_shell->capabilities = calculate_capabilities (gtk_shell);
 
   meta_prefs_add_listener (prefs_changed, gtk_shell);
 
@@ -701,3 +715,16 @@ meta_wayland_init_gtk_shell (MetaWaylandCompositor *compositor)
                           meta_wayland_gtk_shell_new (compositor),
                           g_object_unref);
 }
+
+/*
+ * Sends the gtk_shell1 capabilities to all clients again if they changed.
+ */
+void
+meta_wayland_gtk_shell_update_capabilities (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandGtkShell *gtk_shell =
+    g_object_get_data (G_OBJECT (compositor), "-meta-wayland-gtk-shell");
+
+  if (gtk_shell)
+    update_capabilities (gtk_shell);
+}
