@@ -2512,6 +2594,8 @@ init_tests (void)
                    toplevel_sessions_restore_session_destroyed);
   g_test_add_func ("/wayland/toplevel/sessions/restore-changed",
                    toplevel_sessions_restore_changed);
+  g_test_add_func ("/wayland/toplevel/sessions/restore-other-workspace",
+                   toplevel_sessions_restore_other_workspace);
 #ifdef MUTTER_PRIVILEGED_TEST
   (void)(toplevel_sessions_restore_maximized);
   (void)(toplevel_sessions_restore_tiled);
diff --git a/src/wayland/meta-window-wayland.c b/src/wayland/meta-window-wayland.c
index 6d20598..91e81b0 100644
--- a/src/wayland/meta-window-wayland.c
+++ b/src/wayland/meta-window-wayland.c
@@ -986,7 +986,12 @@ meta_window_wayland_are_updates_frozen (MetaWindow *window)
 {
   MetaWindowWayland *wl_window = META_WINDOW_WAYLAND (window);
 
-  return !wl_window->has_been_shown;
+  if (wl_window->has_been_shown)
+    return FALSE;
+
+  /* A window placed while hidden, as on another workspace, has its monitor and
+   * size, and previews of it, like workspace thumbnails, need its content. */
+  return !(window->placed && window->hidden);
 }
 
 static gboolean
