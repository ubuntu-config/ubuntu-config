diff --git a/src/wayland/meta-window-wayland.c b/src/wayland/meta-window-wayland.c
index 6d20598..7d9da59 100644
--- a/src/wayland/meta-window-wayland.c
+++ b/src/wayland/meta-window-wayland.c
@@ -986,7 +986,17 @@ meta_window_wayland_are_updates_frozen (MetaWindow *window)
 {
   MetaWindowWayland *wl_window = META_WINDOW_WAYLAND (window);
 
-  return !wl_window->has_been_shown;
+  if (wl_window->has_been_shown)
+    return FALSE;
+
+  if (!window->hidden)
+    return TRUE;
+
+  /* A hidden window, as on another workspace, which is placed or maximized,
+   * tiled or fullscreen has its monitor and size, and previews of it, like
+   * workspace thumbnails, need its content. A restored window is placed if
+   * it is floating, and has its target monitor otherwise. */
+  return !(window->placed || !meta_window_config_is_floating (window->config));
 }
 
