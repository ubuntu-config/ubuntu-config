diff --git a/src/tests/stacking/fixed-size-placement.metatest b/src/tests/stacking/fixed-size-placement.metatest
new file mode 100644
index 0000000..7328886
--- /dev/null
+++ b/src/tests/stacking/fixed-size-placement.metatest
@@ -0,0 +1,30 @@
+new_client w wayland
+new_client x x11
+resize_monitor default 250 250
+set_pref center-new-windows false
+
+# Without center-new-windows, a window which can be resized is placed in the
+# first free spot.
+create w/1 csd
+resize w/1 100 100
+show w/1
+assert_position w/1 24 16
+assert_size w/1 100 100
+
+# A window of a fixed size without a parent is centered on the monitor, as a
+# dialog is.
+create w/2 csd
+set_fixed_size w/2 100 100
+show w/2
+assert_size w/2 100 100
+assert_position w/2 75 75
+
+destroy w/2
+
+# The same for an X11 client.
+create x/1 csd
+set_fixed_size x/1 100 100
+show x/1
+wait
+assert_size x/1 100 100
+assert_position x/1 75 75
