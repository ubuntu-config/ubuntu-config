new file mode 100644
index 0000000..8e51d78
--- /dev/null
+++ b/src/wayland/meta-wayland-kde-appmenu.c
@@ -0,0 +1,247 @@
+/*
+ * Copyright (C) 2026 Mitar
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * The org_kde_kwin_appmenu protocol of KDE, with which Chromium, Firefox and
+ * Qt name the D-Bus address of the com.canonical.dbusmenu menu of a window.
+ * The address is kept on the surface, because a client can name it before
+ * the surface has a window, and is read through the MetaWindow of the
+ * surface.
+ */
+
+#include "config.h"
+
+#include "wayland/meta-wayland-kde-appmenu.h"
+
+#include "core/window-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland.h"
+
+#include "kde-appmenu-server-protocol.h"
+
+#define META_KDE_APPMENU_MANAGER_VERSION 2
+
+typedef struct
+{
+  MetaWaylandSurface *surface;
+} MetaKdeAppmenu;
+
+typedef struct
+{
+  /* The appmenu object which set the address */
+  MetaKdeAppmenu *appmenu;
+  char *service_name;
+  char *object_path;
+} MetaKdeAppmenuAddress;
+
+static GQuark address_quark;
+
+static void
+address_free (gpointer data)
+{
+  MetaKdeAppmenuAddress *address = data;
+
+  g_free (address->service_name);
+  g_free (address->object_path);
+  g_free (address);
+}
+
+static void
+notify_window (MetaWaylandSurface *surface)
+{
+  MetaWindow *window = meta_wayland_surface_get_window (surface);
+
+  if (window)
+    meta_window_notify_dbus_appmenu_address (window);
+}
+
+static void
+appmenu_set_address (struct wl_client   *client,
+                     struct wl_resource *resource,
+                     const char         *service_name,
+                     const char         *object_path)
+{
+  MetaKdeAppmenu *appmenu = wl_resource_get_user_data (resource);
+  MetaKdeAppmenuAddress *address;
+
+  if (!appmenu->surface)
+    return;
+
+  address = g_object_get_qdata (G_OBJECT (appmenu->surface), address_quark);
+  if (address && address->appmenu == appmenu &&
+      g_strcmp0 (address->service_name, service_name) == 0 &&
+      g_strcmp0 (address->object_path, object_path) == 0)
+    return;
+
+  address = g_new0 (MetaKdeAppmenuAddress, 1);
+  address->appmenu = appmenu;
+  address->service_name = g_strdup (service_name);
+  address->object_path = g_strdup (object_path);
+  g_object_set_qdata_full (G_OBJECT (appmenu->surface), address_quark,
+                           address, address_free);
+  notify_window (appmenu->surface);
+}
+
+static void
+appmenu_release (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct org_kde_kwin_appmenu_interface appmenu_implementation =
+{
+  appmenu_set_address,
+  appmenu_release,
+};
+
+/* Destroying the appmenu object withdraws the address it set: the protocol
+ * has clients remove the object when they no longer offer a menu. */
+static void
+appmenu_resource_destroy (struct wl_resource *resource)
+{
+  MetaKdeAppmenu *appmenu = wl_resource_get_user_data (resource);
+
+  if (appmenu->surface)
+    {
+      MetaKdeAppmenuAddress *address =
+        g_object_get_qdata (G_OBJECT (appmenu->surface), address_quark);
+
+      if (address && address->appmenu == appmenu)
+        {
+          g_object_set_qdata (G_OBJECT (appmenu->surface), address_quark,
+                              NULL);
+          notify_window (appmenu->surface);
+        }
+
+      g_object_remove_weak_pointer (G_OBJECT (appmenu->surface),
+                                    (gpointer *) &appmenu->surface);
+    }
+
+  g_free (appmenu);
+}
+
+static void
+manager_create (struct wl_client   *client,
+                struct wl_resource *resource,
+                uint32_t            id,
+                struct wl_resource *surface_resource)
+{
+  MetaKdeAppmenu *appmenu;
+  struct wl_resource *appmenu_resource;
+
+  appmenu = g_new0 (MetaKdeAppmenu, 1);
+  appmenu->surface = wl_resource_get_user_data (surface_resource);
+  if (appmenu->surface)
+    {
+      g_object_add_weak_pointer (G_OBJECT (appmenu->surface),
+                                 (gpointer *) &appmenu->surface);
+    }
+
+  appmenu_resource = wl_resource_create (client,
+                                         &org_kde_kwin_appmenu_interface,
+                                         wl_resource_get_version (resource),
+                                         id);
+  wl_resource_set_implementation (appmenu_resource, &appmenu_implementation,
+                                  appmenu, appmenu_resource_destroy);
+}
+
+static void
+manager_release (struct wl_client   *client,
+                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct org_kde_kwin_appmenu_manager_interface manager_implementation =
+{
+  manager_create,
+  manager_release,
+};
+
+static void
+manager_bind (struct wl_client *client,
+              void             *user_data,
+              uint32_t          version,
+              uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client,
+                                 &org_kde_kwin_appmenu_manager_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &manager_implementation,
+                                  user_data, NULL);
+}
+
+void
+meta_wayland_init_kde_appmenu (MetaWaylandCompositor *compositor)
+{
+  struct wl_display *wl_display =
+    meta_wayland_compositor_get_wayland_display (compositor);
+
+  address_quark = g_quark_from_static_string ("meta-kde-appmenu-address");
+
+  if (!wl_global_create (wl_display,
+                         &org_kde_kwin_appmenu_manager_interface,
+                         META_KDE_APPMENU_MANAGER_VERSION,
+                         compositor,
+                         manager_bind))
+    g_error ("Failed to create org_kde_kwin_appmenu_manager global");
+}
+
+static MetaKdeAppmenuAddress *
+get_address (MetaWindow *window)
+{
+  MetaWaylandSurface *surface = meta_window_get_wayland_surface (window);
+
+  if (!surface || !address_quark)
+    return NULL;
+
+  return g_object_get_qdata (G_OBJECT (surface), address_quark);
+}
+
+/**
+ * meta_window_get_dbus_appmenu_service_name:
+ * @window: a #MetaWindow
+ *
+ * Returns: (nullable): the D-Bus name of the client which exports the
+ *   com.canonical.dbusmenu menu of @window, as named with the
+ *   org_kde_kwin_appmenu protocol, or %NULL
+ */
+const char *
+meta_window_get_dbus_appmenu_service_name (MetaWindow *window)
+{
+  MetaKdeAppmenuAddress *address = get_address (window);
+
+  return address ? address->service_name : NULL;
+}
+
+/**
+ * meta_window_get_dbus_appmenu_object_path:
+ * @window: a #MetaWindow
+ *
+ * Returns: (nullable): the D-Bus object path of the com.canonical.dbusmenu
+ *   menu of @window, as named with the org_kde_kwin_appmenu protocol, or %NULL
+ */
+const char *
+meta_window_get_dbus_appmenu_object_path (MetaWindow *window)
+{
+  MetaKdeAppmenuAddress *address = get_address (window);
+
+  return address ? address->object_path : NULL;
+}
