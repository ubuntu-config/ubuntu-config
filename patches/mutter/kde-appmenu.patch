+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Test client for the org_kde_kwin_appmenu protocol: names the menu address
+ * of its window, names it again unchanged, changes it and releases it, each
+ * step after a sync event from the compositor side of the test.
+ */
+
+#include "config.h"
+
+#include <glib.h>
+#include <wayland-client.h>
+
+#include "wayland-test-client-utils.h"
+
+#include "kde-appmenu-client-protocol.h"
+
+static struct org_kde_kwin_appmenu_manager *appmenu_manager;
+
+static void
+handle_registry_global (void               *data,
+                        struct wl_registry *registry,
+                        uint32_t            id,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  if (strcmp (interface, org_kde_kwin_appmenu_manager_interface.name) == 0)
+    {
+      appmenu_manager =
+        wl_registry_bind (registry, id,
+                          &org_kde_kwin_appmenu_manager_interface, 2);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *data,
+                               struct wl_registry *registry,
+                               uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove
+};
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (WaylandDisplay) display = NULL;
+  g_autoptr (WaylandSurface) surface = NULL;
+  struct org_kde_kwin_appmenu *appmenu;
+  struct wl_registry *registry;
+
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, display);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (appmenu_manager);
+
+  surface = wayland_surface_new (display, "kde-appmenu",
+                                 100, 100, 0xffffffff);
+  wl_surface_commit (surface->wl_surface);
+  wait_for_window_configured (display, surface);
+
+  appmenu = org_kde_kwin_appmenu_manager_create (appmenu_manager,
+                                                 surface->wl_surface);
+  test_driver_sync_point (display->test_driver, 0, NULL);
+
+  wait_for_sync_event (display, 0);
+  org_kde_kwin_appmenu_set_address (appmenu, ":1.42", "/MenuBar/1");
+  test_driver_sync_point (display->test_driver, 1, NULL);
+
+  /* Naming the same address again changes nothing, a new one replaces it. */
+  wait_for_sync_event (display, 1);
+  org_kde_kwin_appmenu_set_address (appmenu, ":1.42", "/MenuBar/1");
+  org_kde_kwin_appmenu_set_address (appmenu, ":1.42", "/MenuBar/2");
+  test_driver_sync_point (display->test_driver, 2, NULL);
+
+  wait_for_sync_event (display, 2);
+  org_kde_kwin_appmenu_release (appmenu);
+  test_driver_sync_point (display->test_driver, 3, NULL);
+
+  wait_for_sync_event (display, 3);
+
+  return EXIT_SUCCESS;
+}
