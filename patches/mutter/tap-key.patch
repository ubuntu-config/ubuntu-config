+static void
+tap_key_pref_clear (MetaTapKeyPref *tap_key)
+{
+  g_free (tap_key->sends);
+}
+
+/*
+ * Reads the tap-keys setting. A tapped key which cannot be parsed is left
+ * out.
+ */
+static void
+update_tap_keys (GSettings *settings)
+{
+  g_autoptr (GVariant) value = NULL;
+  GVariantIter iter;
+  const char *key;
+  const char *sends;
+
+  value = g_settings_get_value (settings, KEY_TAP_KEYS);
+
+  g_clear_pointer (&tap_keys, g_array_unref);
+  tap_keys = g_array_new (FALSE, TRUE, sizeof (MetaTapKeyPref));
+  g_array_set_clear_func (tap_keys, (GDestroyNotify) tap_key_pref_clear);
+
+  g_variant_iter_init (&iter, value);
+  while (g_variant_iter_next (&iter, "{&s&s}", &key, &sends))
+    {
+      MetaTapKeyPref tap_key = { 0 };
+
+      if (!parse_special_key (key, tap_key.combos))
+        {
+          meta_topic (META_DEBUG_KEYBINDINGS,
+                      "Failed to parse key \"%s\" of tap-keys", key);
+          continue;
+        }
+
+      tap_key.combos[0].modifiers = 0;
+      tap_key.combos[1].modifiers = 0;
+      tap_key.sends = g_strdup (sends);
+      g_array_append_val (tap_keys, tap_key);
+    }
+
+  queue_changed (META_PREF_KEYBINDINGS);
+}
