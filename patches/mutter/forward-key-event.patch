+static gboolean
+on_key_press_copy (ClutterActor  *actor,
+                   ClutterEvent  *event,
+                   ClutterEvent **copy)
+{
+  if (clutter_event_get_event_code (event) == KEY_N && !*copy)
+    *copy = clutter_event_copy (event);
+
+  return CLUTTER_EVENT_STOP;
+}
+
+static void
+keep_keyboard_focus_forward_key (void)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  MetaWaylandTestClient *wayland_test_client;
+  TestGrab *test_grab;
+  ClutterEvent *key_press = NULL;
+
+  wayland_test_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "keep-keyboard-focus",
+                                            "forward-key",
+                                            NULL);
+  wait_for_sync_point (0);
+  g_assert_nonnull (meta_find_client_window (test_context, "forward-key"));
+
+  /* Ctrl+N pressed during the grab reaches only the grab. */
+  test_grab = test_grab_new (TRUE);
+  g_signal_connect (test_grab->actor, "key-press-event",
+                    G_CALLBACK (on_key_press_copy), &key_press);
+  notify_key (KEY_LEFTCTRL, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (KEY_N, CLUTTER_KEY_STATE_PRESSED);
+  while (!key_press)
+    g_main_context_iteration (NULL, TRUE);
+
+  /* The key is forwarded only once the grab ended, and then the client
+   * receives it with Ctrl held. */
+  g_assert_false (meta_display_forward_key_event (display, key_press));
+  g_clear_pointer (&test_grab, test_grab_free);
+  g_assert_true (meta_display_forward_key_event (display, key_press));
+  g_clear_pointer (&key_press, clutter_event_free);
+  wait_for_sync_point (1);
+
+  notify_key (KEY_N, CLUTTER_KEY_STATE_RELEASED);
+  notify_key (KEY_LEFTCTRL, CLUTTER_KEY_STATE_RELEASED);
+  wait_for_sync_point (2);
+
+  meta_wayland_test_client_finish (wayland_test_client);
+}
