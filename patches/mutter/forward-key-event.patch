+/**
+ * meta_display_forward_key_event:
+ * @display: a #MetaDisplay
+ * @event: a key event, which a stage grab received
+ *
+ * Delivers a key event, which a stage grab received, to the client with the
+ * keyboard focus, as it is delivered without a grab. This suits a key
+ * combination pressed in a menu opened on behalf of the focused window, like a
+ * global menu, which is a shortcut of the window: the menu closes, its grab
+ * ends, and the window receives the key. The release of the key follows
+ * without a grab, so the client receives it as for any other key.
+ *
+ * The event is delivered only once the stage is not grabbed anymore, which
+ * meta_display_set_grab_keeps_keyboard_focus() arranges to leave the keyboard
+ * focus and the modifier state of the window right.
+ *
+ * Returns: %TRUE when a client received the event, %FALSE when it is no key
+ *   event, the stage is still grabbed, or no client has the keyboard focus
+ */
+gboolean
+meta_display_forward_key_event (MetaDisplay        *display,
+                                const ClutterEvent *event)
+{
+  MetaContext *context;
+  MetaBackend *backend;
+  ClutterStage *stage;
+  MetaWaylandCompositor *compositor;
+  ClutterEventType event_type;
+
+  g_return_val_if_fail (META_IS_DISPLAY (display), FALSE);
+  g_return_val_if_fail (event != NULL, FALSE);
+
+  event_type = clutter_event_type (event);
+  if (event_type != CLUTTER_KEY_PRESS && event_type != CLUTTER_KEY_RELEASE)
+    return FALSE;
+
+  context = meta_display_get_context (display);
+  backend = meta_context_get_backend (context);
+  stage = CLUTTER_STAGE (meta_backend_get_stage (backend));
+  if (clutter_stage_get_grab_actor (stage))
+    return FALSE;
+
+  compositor = meta_context_get_wayland_compositor (context);
+  if (!compositor)
+    return FALSE;
+
+  return meta_wayland_compositor_handle_event (compositor, event);
+}
