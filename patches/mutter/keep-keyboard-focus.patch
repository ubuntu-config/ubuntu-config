 static void
 meta_wayland_event_handler_invalidate_focus (MetaWaylandEventHandler *handler,
                                              ClutterFocus            *focus)
 {
   MetaWaylandInput *input = handler->input;
+  MetaWaylandSeat *seat = input->seat;
   MetaWaylandSurface *surface = NULL;
+  gboolean is_current_handler;
+  gboolean keep_keyboard_focus = FALSE;
+  gboolean keyboard_focus_was_kept = FALSE;
 
   if (!focus || !handler->iface->focus)
     return;
 
+  is_current_handler = meta_wayland_input_is_current_handler (input, handler);
+
+  if (CLUTTER_IS_KEY_FOCUS (focus) && is_current_handler)
+    {
+      keep_keyboard_focus = grab_keeps_keyboard_focus (input);
+      keyboard_focus_was_kept = input->keyboard_focus_kept;
+    }
+
   if (handler->iface->get_focus_surface &&
       /* Only the first handler can focus other than a NULL surface */
-      meta_wayland_input_is_current_handler (input, handler) &&
-      /* Stage should either be ungrabbed, or grabbed to self */
+      is_current_handler &&
+      /* Stage should either be ungrabbed, or grabbed to self, or grabbed
+       * for an actor whose grabs leave the keyboard focus in place */
       (!clutter_stage_get_grab_actor (input->stage) ||
-       (input->grab && !clutter_grab_is_revoked (input->grab))))
+       (input->grab && !clutter_grab_is_revoked (input->grab)) ||
+       keep_keyboard_focus))
     {
       surface = handler->iface->get_focus_surface (handler, focus,
                                                    handler->user_data);
     }
 
+  /* X11 clients do not lose their focus when Xwayland loses the keyboard
+   * focus, so Xwayland keeps the usual behavior, which also keeps its idea of
+   * the pressed keys right. */
+  if (keep_keyboard_focus && surface &&
+      meta_wayland_surface_is_xwayland (surface))
+    {
+      keep_keyboard_focus = FALSE;
+      surface = NULL;
+    }
+
+  if (CLUTTER_IS_KEY_FOCUS (focus) && is_current_handler)
+    input->keyboard_focus_kept = keep_keyboard_focus;
+
+  /* Key events do not reach clients during the grab, so a client would never
+   * receive the release of a key held when the grab starts, and would keep
+   * repeating it. */
+  if (keep_keyboard_focus && !keyboard_focus_was_kept &&
+      meta_wayland_seat_has_keyboard (seat))
+    meta_wayland_keyboard_release_delivered_keys (seat->keyboard);
+
   handler->iface->focus (handler,
                          focus, surface,
                          handler->user_data);
+
+  /* Key releases and modifier changes during the grab did not reach the
+   * client either, so a modifier the client received as pressed would stay
+   * pressed for it. Each release is sent before the modifier state, the order
+   * of every key release. */
+  if (keyboard_focus_was_kept && !keep_keyboard_focus &&
+      meta_wayland_seat_has_keyboard (seat))
+    {
+      meta_wayland_keyboard_release_keys_not_pressed (seat->keyboard);
+      meta_wayland_seat_maybe_update_modifiers (seat);
+    }
+}
