+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <linux/input-event-codes.h>
+
+#include "backends/meta-backend-private.h"
+#include "backends/meta-monitor-manager-private.h"
+#include "backends/meta-virtual-monitor.h"
+#include "meta-test/meta-context-test.h"
+#include "meta/display.h"
+#include "tests/meta-test-utils.h"
+#include "tests/meta-wayland-test-driver.h"
+#include "tests/meta-wayland-test-utils.h"
+
+static MetaContext *test_context;
+static MetaWaylandTestDriver *test_driver;
+static MetaVirtualMonitor *virtual_monitor;
+static ClutterVirtualInputDevice *virtual_keyboard;
+
+typedef struct
+{
+  ClutterActor *actor;
+  ClutterGrab *grab;
+  int key_releases;
+} TestGrab;
+
+static void
+wait_for_sync_point (unsigned int sync_point)
+{
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, sync_point);
+}
+
+static gboolean
+on_key_release (ClutterActor *actor,
+                ClutterEvent *event,
+                TestGrab     *test_grab)
+{
+  test_grab->key_releases++;
+  return CLUTTER_EVENT_STOP;
+}
+
+/* Grabs the stage for a new actor and moves the key focus to it. GNOME Shell
+ * does both when it opens a menu. */
+static TestGrab *
+test_grab_new (gboolean keeps_keyboard_focus)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  ClutterStage *stage = CLUTTER_STAGE (meta_backend_get_stage (backend));
+  MetaDisplay *display = meta_context_get_display (test_context);
+  TestGrab *test_grab;
+
+  test_grab = g_new0 (TestGrab, 1);
+  test_grab->actor = clutter_actor_new ();
+  clutter_actor_set_reactive (test_grab->actor, TRUE);
+  clutter_actor_add_child (CLUTTER_ACTOR (stage), test_grab->actor);
+  g_signal_connect (test_grab->actor, "key-release-event",
+                    G_CALLBACK (on_key_release), test_grab);
+
+  if (keeps_keyboard_focus)
+    {
+      meta_display_set_grab_keeps_keyboard_focus (display, test_grab->actor,
+                                                  TRUE);
+    }
+
+  test_grab->grab = clutter_stage_grab (stage, test_grab->actor);
+  clutter_stage_set_key_focus (stage, test_grab->actor);
+
+  return test_grab;
+}
+
+static void
+test_grab_free (TestGrab *test_grab)
+{
+  clutter_grab_dismiss (test_grab->grab);
+  g_object_unref (test_grab->grab);
+  clutter_actor_destroy (test_grab->actor);
+  g_free (test_grab);
+}
+
+static void
+notify_key (uint32_t        key,
+            ClutterKeyState state)
+{
+  clutter_virtual_input_device_notify_key (virtual_keyboard,
+                                           g_get_monotonic_time (),
+                                           key, state);
+}
+
+static void
+press_and_release_key (uint32_t key)
+{
+  notify_key (key, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (key, CLUTTER_KEY_STATE_RELEASED);
+}
+
+static void
+keep_keyboard_focus_keep_focus (void)
+{
+  MetaWaylandTestClient *wayland_test_client;
+  TestGrab *test_grab;
+
+  wayland_test_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "keep-keyboard-focus",
+                                            "keep-focus",
+                                            NULL);
+  wait_for_sync_point (0);
+  g_assert_nonnull (meta_find_client_window (test_context, "keep-focus"));
+
+  notify_key (KEY_LEFTSHIFT, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  wait_for_sync_point (1);
+
+  test_grab = test_grab_new (TRUE);
+  wait_for_sync_point (2);
+
+  /* The grab receives the releases, the client does not. */
+  notify_key (KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  notify_key (KEY_LEFTSHIFT, CLUTTER_KEY_STATE_RELEASED);
+  while (test_grab->key_releases < 2)
+    g_main_context_iteration (NULL, TRUE);
+
+  g_clear_pointer (&test_grab, test_grab_free);
+  wait_for_sync_point (3);
+
+  press_and_release_key (KEY_B);
+  wait_for_sync_point (4);
+
+  meta_wayland_test_client_finish (wayland_test_client);
+}
+
+static void
+keep_keyboard_focus_unmarked_grab (void)
+{
+  MetaWaylandTestClient *wayland_test_client;
+  TestGrab *test_grab;
+
+  wayland_test_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "keep-keyboard-focus",
+                                            "unmarked-grab",
+                                            NULL);
+  wait_for_sync_point (0);
+  g_assert_nonnull (meta_find_client_window (test_context, "unmarked-grab"));
+
+  test_grab = test_grab_new (FALSE);
+  wait_for_sync_point (1);
+
+  g_clear_pointer (&test_grab, test_grab_free);
+  wait_for_sync_point (2);
+
+  meta_wayland_test_client_finish (wayland_test_client);
+}
+
+static void
+keep_keyboard_focus_grab_switch (void)
+{
+  MetaWaylandTestClient *wayland_test_client;
+  TestGrab *marked_grab;
+  TestGrab *unmarked_grab;
+
+  wayland_test_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "keep-keyboard-focus",
+                                            "grab-switch",
+                                            NULL);
+  wait_for_sync_point (0);
+  g_assert_nonnull (meta_find_client_window (test_context, "grab-switch"));
+
+  /* The stage stays grabbed while the grab moves from the marked actor to
+   * the unmarked one and back. */
+  marked_grab = test_grab_new (TRUE);
+  unmarked_grab = test_grab_new (FALSE);
+  wait_for_sync_point (1);
+
+  g_clear_pointer (&unmarked_grab, test_grab_free);
+  wait_for_sync_point (2);
+
+  g_clear_pointer (&marked_grab, test_grab_free);
+  press_and_release_key (KEY_B);
+  wait_for_sync_point (3);
+
+  meta_wayland_test_client_finish (wayland_test_client);
+}
+
+static void
+on_before_tests (void)
+{
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (test_context);
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  ClutterSeat *seat = meta_backend_get_default_seat (backend);
+
+  test_driver = meta_wayland_test_driver_new (compositor);
+  virtual_monitor = meta_create_test_monitor (test_context, 640, 480, 60.0);
+  meta_monitor_manager_reload (monitor_manager);
+
+  /* The headless backend has no keyboard of its own, and without one the
+   * clients receive no keyboard focus at all. */
+  virtual_keyboard = clutter_seat_create_virtual_device (seat,
+                                                         CLUTTER_KEYBOARD_DEVICE);
+}
+
+static void
+on_after_tests (void)
+{
+  g_clear_object (&virtual_keyboard);
+  g_clear_object (&test_driver);
+  g_clear_object (&virtual_monitor);
+}
+
+static void
+init_tests (void)
+{
+  g_test_add_func ("/wayland/keep-keyboard-focus/keep-focus",
+                   keep_keyboard_focus_keep_focus);
+  g_test_add_func ("/wayland/keep-keyboard-focus/unmarked-grab",
+                   keep_keyboard_focus_unmarked_grab);
+  g_test_add_func ("/wayland/keep-keyboard-focus/grab-switch",
+                   keep_keyboard_focus_grab_switch);
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+  g_autoptr (MetaContext) context = NULL;
+
+#ifdef MUTTER_PRIVILEGED_TEST
+  return 0;
+#endif
+
+  context = meta_create_test_context (META_CONTEXT_TEST_TYPE_HEADLESS,
+                                      META_CONTEXT_TEST_FLAG_NO_X11 |
+                                      META_CONTEXT_TEST_FLAG_TEST_CLIENT);
+  g_assert_true (meta_context_configure (context, &argc, &argv, NULL));
+
+  test_context = context;
+
+  init_tests ();
+
+  g_signal_connect (context, "before-tests",
+                    G_CALLBACK (on_before_tests), NULL);
+  g_signal_connect (context, "after-tests",
+                    G_CALLBACK (on_after_tests), NULL);
+
+  return meta_context_test_run_tests (META_CONTEXT_TEST (context),
+                                      META_TEST_RUN_FLAG_NONE);
+}
