+static void
+clear_keyboard_focus_keeping_actors (MetaDisplay *display)
+{
+  MetaDisplayPrivate *priv = meta_display_get_instance_private (display);
+  GHashTableIter iter;
+  gpointer actor, handler_id;
+
+  if (!priv->keyboard_focus_keeping_actors)
+    return;
+
+  g_hash_table_iter_init (&iter, priv->keyboard_focus_keeping_actors);
+  while (g_hash_table_iter_next (&iter, &actor, &handler_id))
+    g_signal_handler_disconnect (actor, GPOINTER_TO_SIZE (handler_id));
+
+  g_clear_pointer (&priv->keyboard_focus_keeping_actors, g_hash_table_unref);
+}
+
+static void
+on_keyboard_focus_keeping_actor_destroy (ClutterActor *actor,
+                                         MetaDisplay  *display)
+{
+  MetaDisplayPrivate *priv = meta_display_get_instance_private (display);
+
+  g_hash_table_remove (priv->keyboard_focus_keeping_actors, actor);
+}
+
+/**
+ * meta_display_set_grab_keeps_keyboard_focus:
+ * @display: a #MetaDisplay
+ * @actor: the actor which stage grabs are made for
+ * @keeps_focus: whether a stage grab for @actor leaves the keyboard focus
+ *   of Wayland clients in place
+ *
+ * Sets whether a stage grab made for @actor leaves the Wayland keyboard focus
+ * of the focused window in place. The window keeps its keyboard focus, and
+ * so its active state in clients which derive it from the keyboard focus,
+ * while the grab receives all key events. This suits menus opened on behalf
+ * of the focused window, like a global menu.
+ *
+ * Keys the window received as pressed and which repeat are released for it
+ * when such a grab starts. When the grab ends, the keys released meanwhile are
+ * released for it and the modifier state is sent to it again. The input
+ * method focus leaves the window during the grab.
+ *
+ * The keyboard focus is decided when the actor of the topmost grab changes,
+ * so this has to be set before the grab for @actor is made.
+ */
+void
+meta_display_set_grab_keeps_keyboard_focus (MetaDisplay  *display,
+                                            ClutterActor *actor,
+                                            gboolean      keeps_focus)
+{
+  MetaDisplayPrivate *priv;
+  gulong handler_id;
+
+  g_return_if_fail (META_IS_DISPLAY (display));
+  g_return_if_fail (CLUTTER_IS_ACTOR (actor));
+
+  priv = meta_display_get_instance_private (display);
+  if (!priv->keyboard_focus_keeping_actors)
+    return;
+
+  handler_id =
+    GPOINTER_TO_SIZE (g_hash_table_lookup (priv->keyboard_focus_keeping_actors,
+                                           actor));
+
+  if (keeps_focus && !handler_id)
+    {
+      handler_id =
+        g_signal_connect (actor, "destroy",
+                          G_CALLBACK (on_keyboard_focus_keeping_actor_destroy),
+                          display);
+      g_hash_table_insert (priv->keyboard_focus_keeping_actors,
+                           actor, GSIZE_TO_POINTER (handler_id));
+    }
+  else if (!keeps_focus && handler_id)
+    {
+      g_signal_handler_disconnect (actor, handler_id);
+      g_hash_table_remove (priv->keyboard_focus_keeping_actors, actor);
+    }
+}
+
+gboolean
+meta_display_grab_keeps_keyboard_focus (MetaDisplay  *display,
+                                        ClutterActor *grab_actor)
+{
+  MetaDisplayPrivate *priv = meta_display_get_instance_private (display);
+
+  return priv->keyboard_focus_keeping_actors &&
+         g_hash_table_contains (priv->keyboard_focus_keeping_actors,
+                                grab_actor);
+}
