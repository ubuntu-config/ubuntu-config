+
+/*
+ * Test client for meta_display_set_grab_keeps_keyboard_focus(). The first
+ * argument names the scenario, which is also the window title. The client
+ * asserts the keyboard events it receives and reports its progress with sync
+ * points, which the compositor side of the test waits for before its next
+ * step.
+ */
+
+#include "config.h"
+
+#include <glib.h>
+#include <linux/input-event-codes.h>
+#include <wayland-client.h>
+
+#include "wayland-test-client-utils.h"
+
+#define SHIFT_MASK (1 << 0)
+
+static gboolean running;
+static struct wl_seat *wl_seat;
+static struct wl_keyboard *wl_keyboard;
+static const char *test_name;
+static int enter_count;
+static int leave_count;
+static int key_count;
+static gboolean shift_pressed;
+static gboolean modifiers_resent;
+
+static void
+sync_point (WaylandDisplay *display,
+            uint32_t        sequence)
+{
+  test_driver_sync_point (display->test_driver, sequence, NULL);
+}
+
+static gboolean
+is_test (const char *name)
+{
+  return g_strcmp0 (test_name, name) == 0;
+}
+
+static void
+keyboard_handle_keymap (void               *data,
+                        struct wl_keyboard *keyboard,
+                        uint32_t            format,
+                        int                 fd,
+                        uint32_t            size)
+{
+}
+
+static void
+keyboard_handle_enter (void               *data,
+                       struct wl_keyboard *keyboard,
+                       uint32_t            serial,
+                       struct wl_surface  *surface,
+                       struct wl_array    *keys)
+{
+  WaylandDisplay *display = data;
+
+  enter_count++;
+
+  if (enter_count == 1)
+    {
+      sync_point (display, 0);
+    }
+  else if (is_test ("unmarked-grab") || is_test ("grab-switch"))
+    {
+      g_assert_cmpint (enter_count, ==, 2);
+      g_assert_cmpint (leave_count, ==, 1);
+      sync_point (display, 2);
+
+      if (is_test ("unmarked-grab"))
+        running = FALSE;
+    }
+  else
+    {
+      g_assert_not_reached ();
+    }
+}
+
+static void
+keyboard_handle_leave (void               *data,
+                       struct wl_keyboard *keyboard,
+                       uint32_t            serial,
+                       struct wl_surface  *surface)
+{
+  WaylandDisplay *display = data;
+
+  /* A grab for an actor which keeps the keyboard focus never sends a leave. */
+  g_assert_false (is_test ("keep-focus"));
+
+  leave_count++;
+  g_assert_cmpint (leave_count, ==, 1);
+  sync_point (display, 1);
+}
+
+static void
+keyboard_handle_key (void               *data,
+                     struct wl_keyboard *keyboard,
+                     uint32_t            serial,
+                     uint32_t            time,
+                     uint32_t            key,
+                     uint32_t            state)
+{
+  WaylandDisplay *display = data;
+
+  key_count++;
+
+  if (is_test ("keep-focus"))
+    {
+      switch (key_count)
+        {
+        case 1:
+          g_assert_cmpint (key, ==, KEY_LEFTSHIFT);
+          g_assert_cmpint (state, ==, WL_KEYBOARD_KEY_STATE_PRESSED);
+          break;
+        case 2:
+          g_assert_cmpint (key, ==, KEY_A);
+          g_assert_cmpint (state, ==, WL_KEYBOARD_KEY_STATE_PRESSED);
+          g_assert_true (shift_pressed);
+          sync_point (display, 1);
+          break;
+        case 3:
+          /* The grab started, which releases the held repeating key, but not
+           * the held modifier. */
+          g_assert_cmpint (key, ==, KEY_A);
+          g_assert_cmpint (state, ==, WL_KEYBOARD_KEY_STATE_RELEASED);
+          g_assert_true (shift_pressed);
+          sync_point (display, 2);
+          break;
+        case 4:
+          /* The grab ended, and Shift, released during it, is released for
+           * the client before the modifier state is sent again. */
+          g_assert_cmpint (key, ==, KEY_LEFTSHIFT);
+          g_assert_cmpint (state, ==, WL_KEYBOARD_KEY_STATE_RELEASED);
+          g_assert_true (shift_pressed);
+          g_assert_false (modifiers_resent);
+          break;
+        case 5:
+          /* The release of A during the grab did not reach the client, which
+           * received it when the grab started. */
+          g_assert_cmpint (key, ==, KEY_B);
+          g_assert_cmpint (state, ==, WL_KEYBOARD_KEY_STATE_PRESSED);
+          g_assert_true (modifiers_resent);
+          g_assert_cmpint (enter_count, ==, 1);
+          sync_point (display, 4);
+          break;
+        case 6:
+          g_assert_cmpint (key, ==, KEY_B);
+          g_assert_cmpint (state, ==, WL_KEYBOARD_KEY_STATE_RELEASED);
+          running = FALSE;
+          break;
+        default:
+          g_assert_not_reached ();
+        }
+    }
+  else if (is_test ("grab-switch"))
+    {
+      /* The key pressed after all grabs ended reaches the client, which kept
+       * its focus when the last grab ended. */
+      g_assert_cmpint (key, ==, KEY_B);
+      g_assert_cmpint (enter_count, ==, 2);
+      g_assert_cmpint (leave_count, ==, 1);
+
+      if (state == WL_KEYBOARD_KEY_STATE_PRESSED)
+        {
+          sync_point (display, 3);
+        }
+      else
+        {
+          running = FALSE;
+        }
+    }
+  else
+    {
+      g_assert_not_reached ();
+    }
+}
+
+static void
+keyboard_handle_modifiers (void               *data,
+                           struct wl_keyboard *keyboard,
+                           uint32_t            serial,
+                           uint32_t            mods_pressed,
+                           uint32_t            mods_latched,
+                           uint32_t            mods_locked,
+                           uint32_t            group)
+{
+  WaylandDisplay *display = data;
+
+  shift_pressed = (mods_pressed & SHIFT_MASK) != 0;
+
+  /* The grab ended, and the modifiers changed during it are sent at once,
+   * not only with the next key. */
+  if (is_test ("keep-focus") && key_count == 4)
+    {
+      g_assert_false (shift_pressed);
+      g_assert_false (modifiers_resent);
+      modifiers_resent = TRUE;
+      sync_point (display, 3);
+    }
+}
+
+static const struct wl_keyboard_listener keyboard_listener = {
+  keyboard_handle_keymap,
+  keyboard_handle_enter,
+  keyboard_handle_leave,
+  keyboard_handle_key,
+  keyboard_handle_modifiers,
+};
+
+static void
+seat_handle_capabilities (void                    *data,
+                          struct wl_seat          *seat,
+                          enum wl_seat_capability  caps)
+{
+  WaylandDisplay *display = data;
+
+  if (caps & WL_SEAT_CAPABILITY_KEYBOARD && !wl_keyboard)
+    {
+      wl_keyboard = wl_seat_get_keyboard (seat);
+      wl_keyboard_add_listener (wl_keyboard, &keyboard_listener, display);
+    }
+}
+
+static void
+seat_handle_name (void           *data,
+                  struct wl_seat *seat,
+                  const char     *name)
+{
+}
+
+static const struct wl_seat_listener seat_listener = {
+  seat_handle_capabilities,
+  seat_handle_name,
+};
+
+static void
+handle_registry_global (void               *data,
+                        struct wl_registry *registry,
+                        uint32_t            id,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  WaylandDisplay *display = data;
+
+  if (strcmp (interface, "wl_seat") == 0)
+    {
+      wl_seat = wl_registry_bind (registry, id, &wl_seat_interface, 1);
+      wl_seat_add_listener (wl_seat, &seat_listener, display);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *data,
+                               struct wl_registry *registry,
+                               uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove
+};
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (WaylandDisplay) display = NULL;
+  g_autoptr (WaylandSurface) surface = NULL;
+  struct wl_registry *registry;
+
+  g_assert_cmpint (argc, ==, 2);
+  test_name = argv[1];
+
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, display);
+  wl_display_roundtrip (display->display);
+
+  surface = wayland_surface_new (display, test_name, 100, 100, 0xffffffff);
+  wl_surface_commit (surface->wl_surface);
+
+  running = TRUE;
+  while (running)
+    wayland_display_dispatch (display);
+
+  wl_display_roundtrip (display->display);
+
+  return EXIT_SUCCESS;
+}
