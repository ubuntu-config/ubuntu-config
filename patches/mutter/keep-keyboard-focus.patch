+/*
+ * Sends a release of each repeating key the focused client received as
+ * pressed. Modifiers do not repeat and can still be held when key events
+ * reach the client again, so they are left as they are.
+ */
+void
+meta_wayland_keyboard_release_delivered_keys (MetaWaylandKeyboard *keyboard)
+{
+  MetaWaylandInputDevice *input_device = META_WAYLAND_INPUT_DEVICE (keyboard);
+  struct wl_array kept_keys;
+  uint32_t time = (uint32_t) (g_get_monotonic_time () / 1000);
+  uint32_t *key;
+
+  wl_array_init (&kept_keys);
+
+  wl_array_for_each (key, &keyboard->delivered_keys)
+    {
+      struct wl_resource *resource;
+      uint32_t serial;
+
+      if (!xkb_keymap_key_repeats (keyboard->xkb_info.keymap, *key + 8))
+        {
+          uint32_t *kept = wl_array_add (&kept_keys, sizeof (*kept));
+
+          *kept = *key;
+          continue;
+        }
+
+      serial = meta_wayland_input_device_next_serial (input_device);
+      wl_resource_for_each (resource, &keyboard->focus_resource_list)
+        {
+          wl_keyboard_send_key (resource, serial, time, *key,
+                                WL_KEYBOARD_KEY_STATE_RELEASED);
+        }
+    }
+
+  wl_array_release (&keyboard->delivered_keys);
+  keyboard->delivered_keys = kept_keys;
+}
+
+/*
+ * Sends a release of each key the focused client received as pressed and
+ * which is no longer pressed, after key events did not reach the client for a
+ * while.
+ */
+void
+meta_wayland_keyboard_release_keys_not_pressed (MetaWaylandKeyboard *keyboard)
+{
+  MetaWaylandInputDevice *input_device = META_WAYLAND_INPUT_DEVICE (keyboard);
+  struct wl_array still_pressed;
+  uint32_t time = (uint32_t) (g_get_monotonic_time () / 1000);
+  uint32_t *key;
+
+  wl_array_init (&still_pressed);
+
+  wl_array_for_each (key, &keyboard->delivered_keys)
+    {
+      struct wl_resource *resource;
+      gboolean pressed = FALSE;
+      uint32_t *pressed_key;
+      uint32_t serial;
+
+      wl_array_for_each (pressed_key, &keyboard->pressed_keys)
+        {
+          if (*pressed_key == *key)
+            pressed = TRUE;
+        }
+
+      if (pressed)
+        {
+          uint32_t *kept = wl_array_add (&still_pressed, sizeof (*kept));
+
+          *kept = *key;
+          continue;
+        }
+
+      serial = meta_wayland_input_device_next_serial (input_device);
+      wl_resource_for_each (resource, &keyboard->focus_resource_list)
+        {
+          wl_keyboard_send_key (resource, serial, time, *key,
+                                WL_KEYBOARD_KEY_STATE_RELEASED);
+        }
+    }
+
+  wl_array_release (&keyboard->delivered_keys);
+  keyboard->delivered_keys = still_pressed;
+}
