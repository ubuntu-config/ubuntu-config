+static gboolean
+grab_keeps_keyboard_focus (MetaWaylandInput *input)
+{
+  MetaContext *context =
+    meta_wayland_compositor_get_context (input->seat->compositor);
+  MetaDisplay *display = meta_context_get_display (context);
+  ClutterActor *grab_actor = clutter_stage_get_grab_actor (input->stage);
+
+  return display && grab_actor &&
+         meta_display_grab_keeps_keyboard_focus (display, grab_actor);
