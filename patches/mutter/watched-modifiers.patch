+/* Reports the use of a pointer or touch while watched modifier keys are
+ * held. */
+static void
+combine_watched_modifiers (MetaDisplay *display)
+{
+  MetaKeyBindingManager *keys = &display->key_binding_manager;
+  unsigned int i;
+
+  for (i = 0; keys->watched_modifiers && i < keys->watched_modifiers->len; i++)
+    {
+      MetaWatchedModifier *modifier =
+        &g_array_index (keys->watched_modifiers, MetaWatchedModifier, i);
+
+      if (modifier->pressed && !modifier->combined)
+        {
+          modifier->combined = TRUE;
+          meta_display_watched_modifier_combined (display, modifier->name);
+        }
+    }
+}
+
+/* Reports the presses and releases of the watched modifier keys, which reach
+ * the focused window all the same. */
+static void
+process_watched_modifiers (MetaDisplay  *display,
+                           ClutterEvent *event)
+{
+  MetaKeyBindingManager *keys = &display->key_binding_manager;
+  ClutterEventType type = clutter_event_type (event);
+  uint32_t hardware_keycode = clutter_event_get_key_code (event);
+  unsigned int i;
+
+  for (i = 0; keys->watched_modifiers && i < keys->watched_modifiers->len; i++)
+    {
+      MetaWatchedModifier *modifier =
+        &g_array_index (keys->watched_modifiers, MetaWatchedModifier, i);
+      gboolean is_modifier =
+        resolved_key_combo_has_keycode (&modifier->resolved_key_combo,
+                                        hardware_keycode);
+
+      if (type == CLUTTER_KEY_PRESS && !is_modifier)
+        {
+          if (modifier->pressed && !modifier->combined)
+            {
+              modifier->combined = TRUE;
+              meta_display_watched_modifier_combined (display, modifier->name);
+            }
+        }
+      else if (type == CLUTTER_KEY_PRESS)
+        {
+          ClutterInputDevice *source = clutter_event_get_source_device (event);
+
+          /* A press with other modifiers held, which includes a repeated
+           * press of the key itself, starts no report. */
+          if ((get_modifiers (event) & ~(IGNORED_MODIFIERS) &
+               CLUTTER_MODIFIER_MASK) != 0)
+            continue;
+
+          if (display->focus_window &&
+              meta_window_shortcuts_inhibited (display->focus_window, source))
+            continue;
+
+          modifier->pressed = TRUE;
+          modifier->combined = FALSE;
+          meta_display_watched_modifier_pressed (display, modifier->name);
+        }
+      else if (type == CLUTTER_KEY_RELEASE && is_modifier && modifier->pressed)
+        {
+          gboolean tapped = !modifier->combined;
+
+          modifier->pressed = FALSE;
+          modifier->combined = FALSE;
+          meta_display_watched_modifier_released (display, modifier->name,
+                                                  tapped);
+        }
+    }
+}
