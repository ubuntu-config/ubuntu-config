+void
+meta_display_watched_modifier_pressed (MetaDisplay *display,
+                                       const char  *key)
+{
+  g_signal_emit (display, display_signals[WATCHED_MODIFIER_PRESSED], 0, key);
+}
+
+void
+meta_display_watched_modifier_combined (MetaDisplay *display,
+                                        const char  *key)
+{
+  g_signal_emit (display, display_signals[WATCHED_MODIFIER_COMBINED], 0, key);
+}
+
+void
+meta_display_watched_modifier_released (MetaDisplay *display,
+                                        const char  *key,
+                                        gboolean     tapped)
+{
+  g_signal_emit (display, display_signals[WATCHED_MODIFIER_RELEASED], 0,
+                 key, tapped);
+}
+
+/**
+ * meta_display_set_watched_modifiers:
+ * @display: a #MetaDisplay
+ * @keys: (array zero-terminated=1) (nullable): the names of modifier keys,
+ *   such as "Alt_L", or "Alt" for both Alt keys
+ *
+ * Sets the modifier keys whose presses and releases @display reports with
+ * #MetaDisplay::watched-modifier-pressed,
+ * #MetaDisplay::watched-modifier-combined and
+ * #MetaDisplay::watched-modifier-released, for example to show what the key
+ * does while it is held, or to act on a tap of it. The keys still reach the
+ * focused window. A press while the focused window inhibits shortcuts is not
+ * reported. %NULL or an empty array stops the reports.
+ */
+void
+meta_display_set_watched_modifiers (MetaDisplay        *display,
+                                    const char * const *keys)
+{
+  g_return_if_fail (META_IS_DISPLAY (display));
+
+  meta_keybindings_set_watched_modifiers (display, keys);
+}
