+static void
+watched_modifier_clear (MetaWatchedModifier *modifier)
+{
+  resolved_key_combo_reset (&modifier->resolved_key_combo);
+  g_free (modifier->name);
+}
+
+static void
+resolve_watched_modifiers (MetaKeyBindingManager *keys)
+{
+  unsigned int i;
+
+  for (i = 0; keys->watched_modifiers && i < keys->watched_modifiers->len; i++)
+    {
+      MetaWatchedModifier *modifier =
+        &g_array_index (keys->watched_modifiers, MetaWatchedModifier, i);
+
+      resolve_special_key_combo (keys, modifier->combos,
+                                 &modifier->resolved_key_combo);
+    }
+}
+
+/* Parses the name of a key, such as "Alt_L", or of both keys of a modifier,
+ * such as "Alt", as the overlay key does. */
+static gboolean
+parse_modifier_key (const char   *name,
+                    MetaKeyCombo  combos[2])
+{
+  g_autofree char *name_l = NULL;
+  g_autofree char *name_r = NULL;
+
+  if (meta_parse_accelerator (name, &combos[0]))
+    return TRUE;
+
+  name_l = g_strconcat (name, "_L", NULL);
+  name_r = g_strconcat (name, "_R", NULL);
+  return meta_parse_accelerator (name_l, &combos[0]) &&
+         meta_parse_accelerator (name_r, &combos[1]);
+}
+
+void
+meta_keybindings_set_watched_modifiers (MetaDisplay        *display,
+                                        const char * const *names)
+{
+  MetaKeyBindingManager *keys = &display->key_binding_manager;
+  unsigned int i;
+
+  g_clear_pointer (&keys->watched_modifiers, g_array_unref);
+  if (!names || !names[0])
+    return;
+
+  keys->watched_modifiers = g_array_new (FALSE, TRUE,
+                                         sizeof (MetaWatchedModifier));
+  g_array_set_clear_func (keys->watched_modifiers,
+                          (GDestroyNotify) watched_modifier_clear);
+
+  for (i = 0; names[i]; i++)
+    {
+      MetaWatchedModifier modifier = { 0 };
+
+      if (!parse_modifier_key (names[i], modifier.combos))
+        {
+          meta_topic (META_DEBUG_KEYBINDINGS,
+                      "Failed to parse watched modifier \"%s\"", names[i]);
+          continue;
+        }
+
+      modifier.combos[0].modifiers = 0;
+      modifier.combos[1].modifiers = 0;
+      modifier.name = g_strdup (names[i]);
+      g_array_append_val (keys->watched_modifiers, modifier);
+    }
+
+  resolve_watched_modifiers (keys);
+}
