+static void
+on_watched_modifier_pressed (MetaDisplay *display,
+                             const char  *key,
+                             GString     *log)
+{
+  g_string_append_printf (log, "pressed %s;", key);
+}
+
+static void
+on_watched_modifier_combined (MetaDisplay *display,
+                              const char  *key,
+                              GString     *log)
+{
+  g_string_append_printf (log, "combined %s;", key);
+}
+
+static void
+on_watched_modifier_released (MetaDisplay *display,
+                              const char  *key,
+                              gboolean     tapped,
+                              GString     *log)
+{
+  g_string_append_printf (log, "released %s %s;",
+                          key, tapped ? "tapped" : "combined");
+}
+
+static void
+flush_events (void)
+{
+  meta_flush_input (test_context);
+  while (g_main_context_iteration (NULL, FALSE)) {}
+}
+
+static void
+test_keybinding_watched_modifiers (void)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  const char *watched[] = { "Alt_L", NULL };
+  ClutterSeat *seat;
+  g_autoptr (ClutterVirtualInputDevice) virtual_keyboard = NULL;
+  g_autoptr (GString) log = g_string_new (NULL);
+  gboolean done = FALSE;
+
+  seat = meta_backend_get_default_seat (backend);
+  virtual_keyboard = clutter_seat_create_virtual_device (seat,
+                                                         CLUTTER_KEYBOARD_DEVICE);
+
+  g_signal_connect (display, "watched-modifier-pressed",
+                    G_CALLBACK (on_watched_modifier_pressed), log);
+  g_signal_connect (display, "watched-modifier-combined",
+                    G_CALLBACK (on_watched_modifier_combined), log);
+  g_signal_connect (display, "watched-modifier-released",
+                    G_CALLBACK (on_watched_modifier_released), log);
+  meta_display_set_watched_modifiers (display, watched);
+
+  g_idle_add_full (G_PRIORITY_LOW,
+                   set_true_cb,
+                   &done,
+                   NULL);
+  while (!done)
+    g_main_context_iteration (NULL, TRUE);
+
+  /* A tap. */
+  notify_key (virtual_keyboard, KEY_LEFTALT, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_LEFTALT, CLUTTER_KEY_STATE_RELEASED);
+  flush_events ();
+  g_assert_cmpstr (log->str, ==, "pressed Alt_L;released Alt_L tapped;");
+  g_string_truncate (log, 0);
+
+  /* Held together with another key. */
+  notify_key (virtual_keyboard, KEY_LEFTALT, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  notify_key (virtual_keyboard, KEY_LEFTALT, CLUTTER_KEY_STATE_RELEASED);
+  flush_events ();
+  g_assert_cmpstr (log->str, ==,
+                   "pressed Alt_L;combined Alt_L;released Alt_L combined;");
+  g_string_truncate (log, 0);
+
+  /* Pressed while another modifier is held, and the other Alt key, which is
+   * not watched. */
+  notify_key (virtual_keyboard, KEY_LEFTCTRL, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_LEFTALT, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_LEFTALT, CLUTTER_KEY_STATE_RELEASED);
+  notify_key (virtual_keyboard, KEY_LEFTCTRL, CLUTTER_KEY_STATE_RELEASED);
+  notify_key (virtual_keyboard, KEY_RIGHTALT, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_RIGHTALT, CLUTTER_KEY_STATE_RELEASED);
+  flush_events ();
+  g_assert_cmpstr (log->str, ==, "");
+
+  /* Without watched keys nothing is reported. */
+  meta_display_set_watched_modifiers (display, NULL);
+  notify_key (virtual_keyboard, KEY_LEFTALT, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_LEFTALT, CLUTTER_KEY_STATE_RELEASED);
+  flush_events ();
+  g_assert_cmpstr (log->str, ==, "");
+
+  g_signal_handlers_disconnect_by_data (display, log);
+}
