Description: Handle input events only after the keymap state queued before them is applied.
 The input thread queues the keymap state resulting from a key event to the main thread with an idle source of
 G_PRIORITY_HIGH before it queues the event, which the backend's event source of G_PRIORITY_DEFAULT dispatches.
 GLib releases its lock while it checks a source, so the idle source can be attached after the sources of higher
 priority were checked in an iteration whose check of the backend's event source then finds the event, and the
 event is handled with the previous keymap state. For a modifier key, the Wayland keyboard then sends no
 wl_keyboard.modifiers, and the client keeps its previous modifiers until the next key or button event.
 .
 The native keymap now counts the updates it queued and did not apply yet, and the backend's event source is
 ready only when there are none, so the update is applied in the next iteration, before the event is handled.
 .
 The test wayland-keyboard, whose client waits for wl_keyboard.modifiers after each modifier key, hung in 5 of 200
 runs with 16 in parallel without the change, and passed 600 of 600 with it.
Author: Mitar
Bug: https://gitlab.gnome.org/GNOME/mutter/-/work_items/5216
Last-Update: 2026-11-15
diff --git a/src/backends/meta-backend.c b/src/backends/meta-backend.c
index 9e9ece8..5d4bf02 100644
--- a/src/backends/meta-backend.c
+++ b/src/backends/meta-backend.c
@@ -89,6 +89,7 @@
 
 #ifdef HAVE_NATIVE_BACKEND
 #include "backends/native/meta-backend-native.h"
+#include "backends/native/meta-keymap-native.h"
 #endif
 
 
@@ -1149,19 +1150,47 @@ dispatch_clutter_event (MetaBackend *backend)
  * of the queue and dispatching them before we block for new events.
  */
 
+static gboolean
+clutter_source_events_ready (GSource *source)
+{
+#ifdef HAVE_NATIVE_BACKEND
+  MetaBackendSource *backend_source = (MetaBackendSource *) source;
+  ClutterSeat *seat = meta_backend_get_default_seat (backend_source->backend);
+  ClutterKeymap *keymap = clutter_seat_get_keymap (seat);
+#endif
+
+  if (!clutter_events_pending ())
+    return FALSE;
+
+#ifdef HAVE_NATIVE_BACKEND
+  /* The input thread queues keymap state updates with a source of higher
+   * priority before the events which caused them. GLib releases its lock while
+   * it checks a source, so such an update can be attached after the sources of
+   * higher priority were checked in the same iteration. An event handled then
+   * would be handled with the previous keymap state, so events wait until the
+   * queued updates are applied.
+   */
+  if (META_IS_KEYMAP_NATIVE (keymap) &&
+      meta_keymap_native_has_pending_updates (META_KEYMAP_NATIVE (keymap)))
+    return FALSE;
+#endif
+
+  return TRUE;
+}
+
 static gboolean
 clutter_source_prepare (GSource *source,
                         int     *timeout)
 {
   *timeout = -1;
 
-  return clutter_events_pending ();
+  return clutter_source_events_ready (source);
 }
 
 static gboolean
 clutter_source_check (GSource *source)
 {
-  return clutter_events_pending ();
+  return clutter_source_events_ready (source);
 }
 
 static gboolean
diff --git a/src/backends/native/meta-keymap-native.c b/src/backends/native/meta-keymap-native.c
index 30962f6..d847c85 100644
