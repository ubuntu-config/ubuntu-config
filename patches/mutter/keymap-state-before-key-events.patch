@@ -57,6 +57,10 @@ struct _MetaKeymapNative
     MetaSeatImpl *seat_impl;
     struct xkb_keymap *keymap;
   } impl;
+
+  /* Keymap and keymap state updates queued from the input thread and not yet
+   * applied in the main thread. */
+  int pending_updates;
 };
 
 typedef struct
@@ -212,6 +216,7 @@ update_keymap_data_free (gpointer user_data)
 {
   UpdateKeymapData *data = user_data;
 
+  g_atomic_int_add (&data->keymap_native->pending_updates, -1);
   meta_keymap_description_unref (data->keymap_description);
   g_strfreev (data->display_names);
   g_strfreev (data->short_names);
@@ -264,6 +269,7 @@ meta_keymap_native_set_keymap_in_impl (MetaKeymapNative      *keymap,
   data->display_names = g_steal_pointer (&display_names);
   data->short_names = g_steal_pointer (&short_names);
 
+  g_atomic_int_inc (&keymap->pending_updates);
   meta_seat_impl_queue_main_thread_idle (seat_impl,
                                          update_keymap_in_main,
                                          data, update_keymap_data_free);
@@ -282,6 +288,15 @@ typedef struct
   ModifierState modifier_state;
 } UpdateLockedModifierStateData;
 
+static void
+update_state_data_free (gpointer user_data)
+{
+  UpdateLockedModifierStateData *data = user_data;
+
+  g_atomic_int_add (&data->keymap_native->pending_updates, -1);
+  g_free (data);
+}
+
 static gboolean
 update_state_in_main (gpointer user_data)
 {
@@ -303,9 +318,24 @@ meta_keymap_native_update_in_impl (MetaKeymapNative *keymap_native,
   data->keymap_native = keymap_native;
   data->modifier_state = calculate_modifier_state (xkb_state);
 
+  g_atomic_int_inc (&keymap_native->pending_updates);
   meta_seat_impl_queue_main_thread_idle (keymap_native->impl.seat_impl,
                                          update_state_in_main,
-                                         data, g_free);
+                                         data, update_state_data_free);
+}
+
+/**
+ * meta_keymap_native_has_pending_updates:
+ * @keymap_native: a #MetaKeymapNative
+ *
+ * Returns: whether keymap or keymap state updates queued from the input
+ *   thread are not yet applied in the main thread. The input thread queues
+ *   them before the events which caused them.
+ */
+gboolean
+meta_keymap_native_has_pending_updates (MetaKeymapNative *keymap_native)
+{
+  return g_atomic_int_get (&keymap_native->pending_updates) > 0;
 }
 
 MetaKeymapNative *
