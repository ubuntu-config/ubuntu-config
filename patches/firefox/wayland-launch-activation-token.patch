+void nsAppShell::InitLaunchActivationToken(const nsACString& aToken) {
+#ifdef MOZ_WAYLAND
+  if (aToken.IsEmpty() || !WaylandDisplayGet()) {
+    return;
+  }
+  // GTK 3 reads the token from DESKTOP_STARTUP_ID and activates the first
+  // toplevel it maps with it. During startup session restore that is a restored
+  // window, which the compositor then focuses and switches to its workspace.
+  // The token is removed from GTK and given to nsGTKToolkit instead, whose
+  // token a window restored from the session does not use, see
+  // nsWindow::SetUserTimeAndStartupTokenForActivatedWindow().
+  static auto sSetStartupNotificationId =
+      (void (*)(GdkDisplay*, const char*))dlsym(
+          RTLD_DEFAULT, "gdk_wayland_display_set_startup_notification_id");
+  GdkDisplay* display = gdk_display_get_default();
+  if (!sSetStartupNotificationId || !display) {
+    return;
+  }
+  sSetStartupNotificationId(display, nullptr);
+  nsGTKToolkit::GetToolkit()->SetActivationToken(aToken);
+#endif
+}
