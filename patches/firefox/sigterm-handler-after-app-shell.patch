Description: Install the SIGTERM handler once the app shell exists, so that SIGTERM quits Firefox cleanly.
 Bug 1837907 added a handler which quits Firefox cleanly on SIGTERM, saving its session, and calls
 nsAppShell::InstallTermSignalHandler() at the end of XREMain::XRE_mainStartup(). XPCOM, which creates the app shell,
 starts only after that function, so the handler finds no app shell and returns without installing anything. SIGTERM
 therefore kills Firefox at once, without saving its session, and the next start recovers from a crash. At the end of
 a desktop session systemd stops the applications still running with SIGTERM, so every logout and shutdown in which
 Firefox was still running counted as a crash.
 .
 The handler is now installed in XREMain::XRE_mainRun(), once XPCOM created the app shell, and still not in background
 task mode. Diagnostic builds assert in nsAppShell::InstallTermSignalHandler() that the app shell exists, and the
 handler ignores SIGTERM with a warning after the app shell is destroyed in shutdown.
 .
 The handler quits through nsIAppStartup::Quit() in the main loop's callback which reads its token, as the session end
 handling does, so the windows close while the event loop runs a task. Ending only the event loop left the quit to
 nsAppStartup::Run() after the loop, outside of any task: closing the windows there ran chrome JavaScript which opened
 an IndexedDB transaction and failed the debug assertion data.mRecursionDepth > mBaseRecursionDepth in
 CycleCollectedJSContext::AddPendingIDBTransaction(), in a try run of the WebDriver tests whose harness stops Firefox
 with SIGTERM. Once Firefox has confirmed its shutdown, the handler still only ends the event loop, as before.
Bug: https://bugzilla.mozilla.org/show_bug.cgi?id=2086801
Author: Mitar
Forwarded: https://phabricator.services.mozilla.com/D340638, https://phabricator.services.mozilla.com/D346993
Last-Update: 2026-11-27
---
diff --git a/toolkit/xre/nsAppRunner.cpp b/toolkit/xre/nsAppRunner.cpp
--- a/toolkit/xre/nsAppRunner.cpp
+++ b/toolkit/xre/nsAppRunner.cpp
@@ -6144,9 +6144,6 @@ int XREMain::XRE_mainStartup(bool* aExitFlag) {
     if (IsWaylandEnabled()) {
       (void)WaylandDisplayGet();
     }
-#endif
-#ifdef MOZ_WIDGET_GTK
-    nsAppShell::InstallTermSignalHandler();
 #endif
   }
 
@@ -6636,6 +6633,12 @@ nsresult XREMain::XRE_mainRun() {
         g_unsetenv(name.get());
       }
       nsAppShell::InitSessionRestore();
+#  ifdef MOZ_BACKGROUNDTASKS
+      if (!BackgroundTasks::IsBackgroundTaskMode())
+#  endif
+      {
+        nsAppShell::InstallTermSignalHandler();
+      }
 #endif
 
 #ifdef XP_MACOSX
diff --git a/widget/gtk/nsAppShell.cpp b/widget/gtk/nsAppShell.cpp
--- a/widget/gtk/nsAppShell.cpp
+++ b/widget/gtk/nsAppShell.cpp
@@ -10,7 +10,9 @@
 #include <sys/types.h>
 #include <unistd.h>
 
+#include "mozilla/AppShutdown.h"
 #include "mozilla/BackgroundHangMonitor.h"
+#include "mozilla/Components.h"
 #include "mozilla/GRefPtr.h"
 #include "mozilla/GUniquePtr.h"
 #include "mozilla/Hal.h"
@@ -23,6 +25,7 @@
 #include "nsAppShell.h"
 #include "nsBaseAppShell.h"
 #include "nsCRT.h"
+#include "nsIAppStartup.h"
 #include "nsIObserverService.h"
 #include "nsIPowerManagerService.h"
 #include "nsWindow.h"
@@ -166,7 +169,14 @@ gboolean nsAppShell::EventProcessorCallb
       self->NativeEventCallback();
       break;
     case QUIT_TOKEN:
-      self->Exit();
+      if (nsCOMPtr<nsIAppStartup> appStartup =
+              components::AppStartup::Service();
+          appStartup &&
+          !AppShutdown::IsInOrBeyond(ShutdownPhase::AppShutdownConfirmed)) {
+        appStartup->Quit(nsIAppStartup::eForceQuit, 0);
+      } else {
+        self->Exit();
+      }
       break;
     default:
       NS_ASSERTION(false, "wrong token");
@@ -436,12 +446,19 @@ void nsAppShell::TermSignalHandler(int s
     NS_WARNING("Wrong signal!");
     return;
   }
+  if (!sAppShell) {
+    NS_WARNING("SIGTERM received without an app shell");
+    return;
+  }
   sAppShell->ScheduleQuitEvent();
 }
 
 void nsAppShell::InstallTermSignalHandler() {
-  if (!XRE_IsParentProcess() || PR_GetEnv("MOZ_DISABLE_SIG_HANDLER") ||
-      !sAppShell) {
+  if (!XRE_IsParentProcess() || PR_GetEnv("MOZ_DISABLE_SIG_HANDLER")) {
+    return;
+  }
+  MOZ_DIAGNOSTIC_ASSERT(sAppShell, "Install the handler after the app shell");
+  if (!sAppShell) {
     return;
   }
 
