+static void WarnSessionMonitorError(const char* aAction, GError* aError) {
+  if (!widget::IsCancelledGError(aError)) {
+    NS_WARNING(
+        nsPrintfCString("Failed to %s: %s", aAction, aError->message).get());
+  }
