+static bool UseXSMP() {
+  const char* dbus = PR_GetEnv("MOZ_DBUS_SESSION_MANAGEMENT");
+  if (dbus && *dbus == '1') {
+    return false;
+  }
+  return getenv("SESSION_MANAGER") && LoadSMLibraries();
+}
+#endif
 
+nsresult NS_CreateNativeAppSupport(nsINativeAppSupport** aResult) {
+  RefPtr<nsNativeAppSupportBase> native;
+#if MOZ_X11
+  bool disabled = HasArg("--sm-disable");
+  if (!disabled && UseXSMP()) {
+    native = new nsNativeAppSupportXSMP();
+  }
+#else
+  bool disabled = false;
+#endif
+#ifdef MOZ_ENABLE_DBUS
+  if (!native && !disabled) {
+    native = new nsNativeAppSupportDBus();
+  }
+#endif
+  if (!native) {
+    native = new nsNativeAppSupportUnix();
+  }
+  native.forget(aResult);
