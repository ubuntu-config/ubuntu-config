+dom::Element* NativeMenu::GetIconOwner(const nsINode& aNode) {
+  if (!aNode.IsHTMLElement(nsGkAtoms::img)) {
+    return nullptr;
+  }
+  dom::Element* parent = aNode.GetParentElement();
+  if (!parent ||
+      !parent->IsAnyOfXULElements(nsGkAtoms::menu, nsGkAtoms::menuitem) ||
+      parent->GetFirstElementChild() != &aNode) {
+    return nullptr;
+  }
+  return parent;
+}
