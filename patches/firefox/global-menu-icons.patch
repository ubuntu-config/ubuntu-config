+// The size of the icons of menu items, twice the 16 pixels at which menus show
+// them, so that they stay sharp on screens with a scale of up to 2. Clients
+// scale larger icons down to the size they show.
+static constexpr int32_t kDBusMenuIconSize = 32;
+
+// The icon of a DbusmenuMenuitem, see NativeMenu::GetIcon, which it owns. The
+// icon is loaded whenever the URL of the item's icon changes, and set as the
+// icon data of the item once it is loaded.
+class DBusMenuItemIcon final : public IconLoader::Listener {
+ public:
+  explicit DBusMenuItemIcon(DbusmenuMenuitem* aItem) : mItem(aItem) {}
+
+  ~DBusMenuItemIcon() {
+    if (mLoader) {
+      mLoader->Destroy();
+    }
+  }
+
+  const dom::Element* LastElement() const { return mLastElement; }
+
+  // Makes the next Update() look at the icon also for the element it looked at
+  // last, as an item which shows no element may show another one at the same
+  // address later.
+  void ForgetElement() { mLastElement = nullptr; }
+
+  void Update(dom::Element& aElement) {
+    mLastElement = &aElement;
+    NativeMenuIcon icon = NativeMenu::GetIcon(aElement);
+    nsAutoCString spec;
+    if (icon) {
+      icon.mURI->GetSpec(spec);
+    }
+    if (spec == mSpec) {
+      return;
+    }
+    mSpec = spec;
+    if (mLoader) {
+      mLoader->Destroy();
+      mLoader = nullptr;
+    }
+    if (!icon) {
+      dbusmenu_menuitem_property_remove(mItem,
+                                        DBUSMENU_MENUITEM_PROP_ICON_DATA);
+      return;
+    }
+    mStyle = std::move(icon.mStyle);
+    mPresContext = aElement.OwnerDoc()->GetPresContext();
+    mLoader = new IconLoader(this);
+    if (NS_FAILED(mLoader->LoadIcon(icon.mURI, &aElement))) {
+      mLoader->Destroy();
+      mLoader = nullptr;
+      mStyle = nullptr;
+      mPresContext = nullptr;
+      dbusmenu_menuitem_property_remove(mItem,
+                                        DBUSMENU_MENUITEM_PROP_ICON_DATA);
+    }
+  }
+
+  nsresult OnComplete(imgIContainer* aImage) override {
+    RefPtr<GdkPixbuf> pixbuf = ToPixbuf(aImage);
+    mStyle = nullptr;
+    mPresContext = nullptr;
+    if (pixbuf) {
+      dbusmenu_menuitem_property_set_image(
+          mItem, DBUSMENU_MENUITEM_PROP_ICON_DATA, pixbuf);
+    } else {
+      dbusmenu_menuitem_property_remove(mItem,
+                                        DBUSMENU_MENUITEM_PROP_ICON_DATA);
+    }
+    RefPtr<IconLoader> loader = std::move(mLoader);
+    loader->Destroy();
+    return NS_OK;
+  }
+
+ private:
+  // Returns aImage at kDBusMenuIconSize. A vector image is drawn with the
+  // context paint of the menu item's style, as the menus in the window draw it,
+  // so that an icon which uses context-fill or context-stroke has the colors of
+  // the menu item and not its fallback colors.
+  already_AddRefed<GdkPixbuf> ToPixbuf(imgIContainer* aImage) {
+    const nsIntSize size(kDBusMenuIconSize, kDBusMenuIconSize);
+    RefPtr<nsPresContext> presContext = mPresContext.get();
+    if (aImage->GetType() != imgIContainer::TYPE_VECTOR || !presContext ||
+        !mStyle) {
+      return nsImageToPixbuf::ImageToPixbuf(aImage, Some(size));
+    }
+    RefPtr<gfx::DrawTarget> drawTarget =
+        gfxPlatform::GetPlatform()->CreateOffscreenContentDrawTarget(
+            size, gfx::SurfaceFormat::B8G8R8A8);
+    if (!drawTarget || !drawTarget->IsValid()) {
+      return nullptr;
+    }
+    gfxContext context(drawTarget);
+    SVGImageContext svgContext;
+    SVGImageContext::MaybeStoreContextPaint(svgContext, *presContext, *mStyle,
+                                            aImage);
+    if (aImage->Draw(
+            &context, size, image::ImageRegion::Create(size),
+            imgIContainer::FRAME_CURRENT, gfx::SamplingFilter::POINT,
+            svgContext,
+            imgIContainer::FLAG_SYNC_DECODE | imgIContainer::FLAG_ASYNC_NOTIFY,
+            1.0) != image::ImgDrawResult::SUCCESS) {
+      return nullptr;
+    }
+    RefPtr<gfx::SourceSurface> surface = drawTarget->Snapshot();
+    return nsImageToPixbuf::SourceSurfaceToPixbuf(surface, size.width,
+                                                  size.height);
+  }
+
+  DbusmenuMenuitem* const mItem;
+  RefPtr<IconLoader> mLoader;
+  // The style and the document of the icon which is being loaded, for its
+  // context paint.
+  RefPtr<const ComputedStyle> mStyle;
+  WeakPtr<nsPresContext> mPresContext;
+  // The menu item whose icon was looked at last, only compared and never
+  // dereferenced, as the menu item may be gone.
+  const dom::Element* mLastElement = nullptr;
+  // The URL of the icon loaded last, empty for an item without an icon.
+  nsCString mSpec;
+};
+
+// The key of the DBusMenuItemIcon of a DbusmenuMenuitem.
+static constexpr char kIconKey[] = "moz-menu-item-icon";
+
+// Looks at the icon of aElement for aItem. Unless aForce is true, an item
+// which already has the icon of aElement keeps it, as changes of the icon
+// arrive through MenubarModelDBus::IconsChanged().
+static void UpdateIcon(DbusmenuMenuitem* aItem, dom::Element& aElement,
+                       bool aForce) {
+  auto* icon = static_cast<DBusMenuItemIcon*>(
+      g_object_get_data(G_OBJECT(aItem), kIconKey));
+  if (!icon) {
+    icon = new DBusMenuItemIcon(aItem);
+    g_object_set_data_full(G_OBJECT(aItem), kIconKey, icon, [](gpointer aIcon) {
+      delete static_cast<DBusMenuItemIcon*>(aIcon);
+    });
+  } else if (!aForce && icon->LastElement() == &aElement) {
+    return;
+  }
+  icon->Update(aElement);
+}
+
+static void ForgetIconElement(DbusmenuMenuitem* aItem) {
+  if (auto* icon = static_cast<DBusMenuItemIcon*>(
+          g_object_get_data(G_OBJECT(aItem), kIconKey))) {
+    icon->ForgetElement();
+  }
+}
+
+// Updates the icons of the items below aParent which show one of aMenuItems.
+static void UpdateIcons(DbusmenuMenuitem* aParent,
+                        const nsTHashSet<RefPtr<dom::Element>>& aMenuItems) {
+  for (GList* l = dbusmenu_menuitem_get_children(aParent); l; l = l->next) {
+    auto* item = static_cast<DbusmenuMenuitem*>(l->data);
+    dom::Element* element = Props::Element(item);
+    if (element && aMenuItems.Contains(element)) {
+      UpdateIcon(item, *element, /* aForce */ true);
+    }
+    UpdateIcons(item, aMenuItems);
+  }
+}
+
+void MenubarModelDBus::IconsChanged(
+    const nsTHashSet<RefPtr<dom::Element>>& aMenuItems) {
+  UpdateIcons(mRoot.get(), aMenuItems);
+}
