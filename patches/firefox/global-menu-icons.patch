+// Returns the menu item whose icon aNode is, see NativeMenu::GetIcon(), or
+// null. A menu item adds its icon only when it is first shown, which is after
+// the item itself was added.
+static dom::Element* IconOwner(const nsINode& aNode) {
+  if (!aNode.IsHTMLElement(nsGkAtoms::img)) {
+    return nullptr;
+  }
+  dom::Element* parent = aNode.GetParentElement();
+  if (!parent || !parent->IsXULElement(nsGkAtoms::menuitem) ||
+      parent->GetFirstElementChild() != &aNode) {
+    return nullptr;
+  }
+  return parent;
+}
