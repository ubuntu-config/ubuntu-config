 }
 
+static gboolean
+editor_session_shutdown_timeout_cb (gpointer user_data)
+{
+  gboolean *timed_out = user_data;
+
+  *timed_out = TRUE;
+
+  return G_SOURCE_REMOVE;
+}
+
+/**
+ * _editor_session_save_at_shutdown:
+ * @self: a #EditorSession
+ *
+ * Saves the session for shutdown, unless such a save was requested already,
+ * and returns once every save of the session finished, or after
+ * SHUTDOWN_SAVE_TIMEOUT_SECONDS with a warning. Does nothing when the session
+ * does not restore its pages.
+ */
+void
+_editor_session_save_at_shutdown (EditorSession *self)
+{
+  gboolean timed_out = FALSE;
+  guint timeout_id;
+
+  g_return_if_fail (EDITOR_IS_SESSION (self));
+
+  /* A session which does not restore its pages restores them only when it
+   * was not shut down, so that unsaved documents return after a crash. Its
+   * unsaved documents hold the logout instead, see
+   * editor_window_update_inhibit().
+   */
+  if (!self->restore_pages)
+    return;
+
+  /* Closing the last window and quitting request a save for shutdown and quit
+   * once it finished. When the session of the desktop ends, GTK quits the
+   * application without either, with its windows still open.
+   */
+  if (!self->shutdown_save_requested)
+    editor_session_save_async (self, TRUE, NULL, NULL, NULL);
+
+  /* The application no longer runs its main loop, so the saves are run here. */
+  timeout_id = g_timeout_add_seconds (SHUTDOWN_SAVE_TIMEOUT_SECONDS,
+                                      editor_session_shutdown_timeout_cb,
+                                      &timed_out);
+  while (!timed_out && (self->saving || !g_queue_is_empty (&self->pending_saves)))
+    g_main_context_iteration (NULL, TRUE);
+
+  if (timed_out)
+    g_warning ("Saving the session did not finish within %u seconds",
+               SHUTDOWN_SAVE_TIMEOUT_SECONDS);
+  else
+    g_source_remove (timeout_id);
+}
+
 gboolean
 editor_session_save_finish (EditorSession  *self,
                             GAsyncResult   *result,
