diff --git a/src/editor-session.c b/src/editor-session.c
index 387a270..abe99b5 100644
--- a/src/editor-session.c
+++ b/src/editor-session.c
@@ -1395,18 +1395,32 @@ editor_session_save_for_shutdown_cb (GObject      *object,
   g_application_quit (g_application_get_default ());
 }
 
+/**
+ * _editor_session_remove_window:
+ * @self: an #EditorSession
+ * @window: the #EditorWindow to remove
+ * @closed: whether the user closed @window
+ *
+ * Removes @window from the session. Removing the last window saves the
+ * session and quits once the save finished. A window the user closed leaves
+ * the session with its pages, the last one too, so that the next start
+ * restores only the windows which were open when Text Editor quit or ended.
+ * The quit action saves the session with every window before any is removed.
+ */
 void
 _editor_session_remove_window (EditorSession *self,
-                               EditorWindow  *window)
+                               EditorWindow  *window,
+                               gboolean       closed)
 {
+  gboolean is_last;
+
   g_return_if_fail (EDITOR_IS_SESSION (self));
   g_return_if_fail (EDITOR_IS_WINDOW (window));
 
-  /* If this is the last window, then we want to save the session
-   * so that we can restore it next time we start.
-   */
-  if (self->windows->len == 1 &&
-      EDITOR_WINDOW (g_ptr_array_index (self->windows, 0)) == window)
+  is_last = self->windows->len == 1 &&
+            EDITOR_WINDOW (g_ptr_array_index (self->windows, 0)) == window;
+
+  if (is_last)
     {
       int width, height;
 
@@ -1417,7 +1431,13 @@ _editor_session_remove_window (EditorSession *self,
           default_width = width;
           default_height = height;
         }
+    }
 
+  /* The last window destroyed without being closed by the user stays in the
+   * session, so that the next start restores it.
+   */
+  if (is_last && !closed)
+    {
       editor_session_save_async (self,
                                  TRUE,
                                  NULL,
@@ -1447,7 +1467,17 @@ _editor_session_remove_window (EditorSession *self,
 
   g_object_unref (window);
 
-  _editor_session_mark_dirty (self);
+  /* A save captures the session when it is requested, so the closed last
+   * window and its pages are left out of it.
+   */
+  if (is_last)
+    editor_session_save_async (self,
+                               TRUE,
+                               NULL,
+                               editor_session_save_for_shutdown_cb,
+                               NULL);
+  else
+    _editor_session_mark_dirty (self);
 }
 
 static int
