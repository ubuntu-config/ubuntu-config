+
+typedef enum
+{
+  FAKE_SYSTEMD_REFUSE,
+  FAKE_SYSTEMD_FAIL_JOB,
+  FAKE_SYSTEMD_PENDING,
+} FakeSystemdMode;
+
+/* Owns systemd's name on the test's session bus, in a thread of its own, and
+ * answers StartTransientUnit as its mode says. */
+typedef struct
+{
+  FakeSystemdMode mode;
+  GThread *thread;
+  GMainContext *context;
+  GMainLoop *loop;
+  GMutex lock;
+  GCond cond;
+  gboolean ready;
+  guint32 caller_pid;  /* process which asked for a scope, 0 until one did */
+} FakeSystemd;
+
+static const gchar fake_systemd_xml[] =
+  "<node>"
+  "  <interface name='org.freedesktop.systemd1.Manager'>"
+  "    <method name='StartTransientUnit'>"
+  "      <arg type='s' direction='in'/>"
+  "      <arg type='s' direction='in'/>"
+  "      <arg type='a(sv)' direction='in'/>"
+  "      <arg type='a(sa(sv))' direction='in'/>"
+  "      <arg type='o' direction='out'/>"
+  "    </method>"
+  "    <signal name='JobRemoved'>"
+  "      <arg type='u'/>"
+  "      <arg type='o'/>"
+  "      <arg type='s'/>"
+  "      <arg type='s'/>"
+  "    </signal>"
+  "  </interface>"
+  "</node>";
+
+static void
+fake_systemd_method_call (GDBusConnection       *connection,
+                          const gchar           *sender,
+                          const gchar           *object_path,
+                          const gchar           *interface_name,
+                          const gchar           *method_name,
+                          GVariant              *parameters,
+                          GDBusMethodInvocation *invocation,
+                          gpointer               user_data)
+{
+  FakeSystemd *fake = user_data;
+  const gchar *job = "/org/freedesktop/systemd1/job/1";
+  const gchar *unit;
+  GVariant *reply;
+  guint32 caller_pid = 0;
+
+  reply = g_dbus_connection_call_sync (connection, "org.freedesktop.DBus", "/org/freedesktop/DBus",
+                                       "org.freedesktop.DBus", "GetConnectionUnixProcessID",
+                                       g_variant_new ("(s)", sender), G_VARIANT_TYPE ("(u)"),
+                                       G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL);
+  if (reply != NULL)
+    {
+      g_variant_get (reply, "(u)", &caller_pid);
+      g_variant_unref (reply);
+    }
+
+  g_mutex_lock (&fake->lock);
+  fake->caller_pid = caller_pid;
+  g_cond_broadcast (&fake->cond);
+  g_mutex_unlock (&fake->lock);
+
+  g_variant_get (parameters, "(&s&s@a(sv)@a(sa(sv)))", &unit, NULL, NULL, NULL);
+
+  switch (fake->mode)
+    {
+    case FAKE_SYSTEMD_REFUSE:
+      g_dbus_method_invocation_return_dbus_error (invocation, "org.freedesktop.DBus.Error.AccessDenied",
+                                                  "Refused by the test");
+      break;
+    case FAKE_SYSTEMD_FAIL_JOB:
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(o)", job));
+      g_dbus_connection_emit_signal (connection, NULL, "/org/freedesktop/systemd1",
+                                     "org.freedesktop.systemd1.Manager", "JobRemoved",
+                                     g_variant_new ("(uoss)", 1, job, unit, "failed"), NULL);
+      break;
+    case FAKE_SYSTEMD_PENDING:
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(o)", job));
+      break;
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+fake_systemd_name_acquired (GDBusConnection *connection,
+                            const gchar     *name,
+                            gpointer         user_data)
+{
+  FakeSystemd *fake = user_data;
+
+  g_mutex_lock (&fake->lock);
+  fake->ready = TRUE;
+  g_cond_broadcast (&fake->cond);
+  g_mutex_unlock (&fake->lock);
+}
+
+static gpointer
+fake_systemd_thread (gpointer user_data)
+{
+  FakeSystemd *fake = user_data;
+  const GDBusInterfaceVTable vtable = { fake_systemd_method_call, NULL, NULL, { 0 } };
+  GDBusNodeInfo *node;
+  GDBusConnection *connection;
+  GError *error = NULL;
+  guint registration_id;
+  guint owner_id;
+
+  g_main_context_push_thread_default (fake->context);
+
+  connection = g_dbus_connection_new_for_address_sync (g_getenv ("DBUS_SESSION_BUS_ADDRESS"),
+                                                       G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                                       G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+                                                       NULL, NULL, &error);
+  g_assert_no_error (error);
+
+  node = g_dbus_node_info_new_for_xml (fake_systemd_xml, &error);
+  g_assert_no_error (error);
+  registration_id = g_dbus_connection_register_object (connection, "/org/freedesktop/systemd1",
+                                                       node->interfaces[0], &vtable, fake, NULL, &error);
+  g_assert_no_error (error);
+  owner_id = g_bus_own_name_on_connection (connection, "org.freedesktop.systemd1",
+                                           G_BUS_NAME_OWNER_FLAGS_NONE,
+                                           fake_systemd_name_acquired, NULL, fake, NULL);
+
+  g_main_loop_run (fake->loop);
+
+  g_bus_unown_name (owner_id);
+  g_dbus_connection_unregister_object (connection, registration_id);
+  g_dbus_connection_close_sync (connection, NULL, NULL);
+  g_object_unref (connection);
+  g_dbus_node_info_unref (node);
+  g_main_context_pop_thread_default (fake->context);
+
+  return NULL;
+}
+
+static FakeSystemd *
+fake_systemd_start (FakeSystemdMode mode)
+{
+  FakeSystemd *fake = g_new0 (FakeSystemd, 1);
+
+  fake->mode = mode;
+  fake->context = g_main_context_new ();
+  fake->loop = g_main_loop_new (fake->context, FALSE);
+  g_mutex_init (&fake->lock);
+  g_cond_init (&fake->cond);
+  fake->thread = g_thread_new ("fake-systemd", fake_systemd_thread, fake);
+
+  g_mutex_lock (&fake->lock);
+  while (!fake->ready)
+    g_cond_wait (&fake->cond, &fake->lock);
+  g_mutex_unlock (&fake->lock);
+
+  return fake;
+}
+
+/* Waits until a process asked @fake for a scope, and returns its process ID,
+ * or 0 if none did within a few seconds. */
+static guint32
+fake_systemd_wait_for_caller (FakeSystemd *fake)
+{
+  gint64 deadline = g_get_monotonic_time () + 5 * G_USEC_PER_SEC;
+  guint32 pid;
+
+  g_mutex_lock (&fake->lock);
+  while (fake->caller_pid == 0 && g_cond_wait_until (&fake->cond, &fake->lock, deadline))
+    ;
+  pid = fake->caller_pid;
+  g_mutex_unlock (&fake->lock);
+
+  return pid;
+}
+
+static void
+fake_systemd_stop (FakeSystemd *fake)
+{
+  g_main_loop_quit (fake->loop);
+  g_thread_join (fake->thread);
+  g_main_loop_unref (fake->loop);
+  g_main_context_unref (fake->context);
+  g_mutex_clear (&fake->lock);
+  g_cond_clear (&fake->cond);
+  g_free (fake);
+}
