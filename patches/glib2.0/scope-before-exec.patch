+/* Spawns gio-launch-desktop to put a shell into a scope of its own, which
+ * prints the variables gio-launch-desktop removes. gio-launch-desktop logs to
+ * @error_fd, as standard error is not the journal. */
+static gboolean
+spawn_launch_desktop_with_scope (int  *output_fd,
+                                 int  *error_fd,
+                                 GPid *pid)
+{
+  const gchar *launch_desktop = g_getenv ("GIO_LAUNCH_DESKTOP");
+  const gchar *argv[] = {
+    NULL, "/bin/sh", "-c",
+    "echo \"${GIO_LAUNCH_DESKTOP_SCOPE-unset} ${GIO_LAUNCH_DESKTOP_SCOPE_DESCRIPTION-unset}\"",
+    NULL
+  };
+  int out_fds[2];
+  int err_fds[2];
+  gchar **envp;
+  GError *error = NULL;
+
+  if (launch_desktop == NULL)
+    {
+      g_test_skip ("GIO_LAUNCH_DESKTOP is not set");
+      return FALSE;
+    }
+  argv[0] = launch_desktop;
+
+  g_unix_open_pipe (out_fds, O_CLOEXEC, &error);
+  g_assert_no_error (error);
+  g_unix_open_pipe (err_fds, O_CLOEXEC, &error);
+  g_assert_no_error (error);
+
+  envp = g_get_environ ();
+  envp = g_environ_setenv (envp, "GIO_LAUNCH_DESKTOP_SCOPE", "app-glib-test-", TRUE);
+  envp = g_environ_setenv (envp, "GIO_LAUNCH_DESKTOP_SCOPE_DESCRIPTION", "GLib test", TRUE);
+
+  g_spawn_async_with_fds (NULL, (gchar **) argv, envp,
+                          G_SPAWN_DO_NOT_REAP_CHILD,
+                          NULL, NULL, pid,
+                          -1, out_fds[1], err_fds[1],
+                          &error);
+  g_assert_no_error (error);
+
+  g_close (out_fds[1], NULL);
+  g_close (err_fds[1], NULL);
+  *output_fd = out_fds[0];
+  *error_fd = err_fds[0];
+
+  g_strfreev (envp);
+
+  return TRUE;
+}
+
+static gboolean
+output_ready (int fd,
+              int timeout_ms)
+{
+  struct pollfd pfd = { fd, POLLIN, 0 };
+  int r;
+
+  do
+    r = poll (&pfd, 1, timeout_ms);
+  while (r < 0 && errno == EINTR);
+  g_assert_cmpint (r, >=, 0);
+
+  return r > 0;
+}
