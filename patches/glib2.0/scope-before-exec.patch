+/*
+ * wait_for_scope:
+ *
+ * When GDesktopAppInfo puts the application in a scope of its own, it sets
+ * GIO_LAUNCH_DESKTOP_SCOPE to the name of the scope without its trailing
+ * "<pid>.scope", and GIO_LAUNCH_DESKTOP_SCOPE_DESCRIPTION to the description
+ * of the scope. Asking systemd for the scope here, and waiting until systemd
+ * has moved this process into it, before the application is executed, makes
+ * the application and every process it starts belong to the scope from the
+ * beginning. The application runs either way.
+ *
+ * Both variables are removed, so that the application does not see them.
+ */
+static void
+wait_for_scope (void)
+{
+  const char *prefix;
+  char *description = NULL;
+  const char *application;
+  char unit[NAME_MAX + 1];
+  int r = -1;
+
+  prefix = getenv ("GIO_LAUNCH_DESKTOP_SCOPE");
+  if (prefix != NULL)
+    r = snprintf (unit, sizeof (unit), "%s%ld.scope", prefix, (long) getpid ());
+  if (getenv ("GIO_LAUNCH_DESKTOP_SCOPE_DESCRIPTION") != NULL)
+    description = strdup (getenv ("GIO_LAUNCH_DESKTOP_SCOPE_DESCRIPTION"));
+
+  unsetenv ("GIO_LAUNCH_DESKTOP_SCOPE");
+  unsetenv ("GIO_LAUNCH_DESKTOP_SCOPE_DESCRIPTION");
+
+  if (r >= 0 && (size_t) r < sizeof (unit))
+    {
+      application = getenv ("GIO_LAUNCHED_DESKTOP_FILE");
+      if (application == NULL)
+        application = "the application";
+
+      request_scope (unit, description, application);
+    }
+
+  free (description);
+}
