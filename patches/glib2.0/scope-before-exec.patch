+/* How long to wait for the scope at most, and how often to check whether this
+ * process is in it already. Waiting ends as soon as it is, or as soon as
+ * systemd refused the scope or failed to start it, so the limit is reached
+ * only when systemd did not process the request for a minute. Running the
+ * application before systemd moved the process would leave every process the
+ * application started until then outside of the scope, so the limit is long. */
+#define SCOPE_TIMEOUT_MS 60000
+#define SCOPE_POLL_MS 1
+
+/*
+ * is_in_unit:
+ * @unit: name of a systemd unit
+ *
+ * Returns: nonzero if this process is in the cgroup of @unit, or in one below
+ *     it, as listed for the unified hierarchy in /proc/self/cgroup
+ */
+static int
+is_in_unit (const char *unit)
+{
+  char buf[4096];
+  char *line;
+  char *line_end;
+  const char *match;
+  size_t unit_len = strlen (unit);
+  ssize_t len = 0;
+  ssize_t r;
+  int fd;
+
+  fd = open ("/proc/self/cgroup", O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    return 0;
+
+  do
+    {
+      r = read (fd, buf + len, sizeof (buf) - 1 - (size_t) len);
+      if (r > 0)
+        len += r;
+    }
+  while ((r > 0 && (size_t) len < sizeof (buf) - 1) || (r < 0 && errno == EINTR));
+  close (fd);
+
+  if (r < 0)
+    return 0;
+
+  buf[len] = '\0';
+
+  if (strncmp (buf, "0::", 3) == 0)
+    line = buf;
+  else if ((line = strstr (buf, "\n0::")) != NULL)
+    line++;
+  else
+    return 0;
+
+  line_end = strchr (line, '\n');
+  if (line_end != NULL)
+    *line_end = '\0';
+
+  /* A process in a scope can be moved further into a cgroup below it, as
+   * Fedora's uresourced does with every process of an application. */
+  for (match = strstr (line, unit); match != NULL; match = strstr (match + 1, unit))
+    {
+      if (match > line && match[-1] == '/' && (match[unit_len] == '\0' || match[unit_len] == '/'))
+        return 1;
+    }
+
+  return 0;
+}
+
+static void log_message (int priority, const char *format, ...) G_GNUC_PRINTF (2, 3);
+
+/*
+ * log_message:
+ * @priority: syslog priority of the message, such as LOG_ERR
+ * @format: printf() format of the message
+ *
+ * Logs a message. When standard error is connected to the journal, whose
+ * stream gives every line it receives the same priority, the message goes to
+ * the journal through syslog instead, so that it keeps @priority. Otherwise it
+ * goes to standard error.
+ */
+static void
+log_message (int         priority,
+             const char *format,
+             ...)
+{
+  char message[1024];
+  va_list args;
+
+  va_start (args, format);
+  vsnprintf (message, sizeof (message), format, args);
+  va_end (args);
+
+  if (_g_fd_is_journal (STDERR_FILENO))
+    {
+      openlog ("gio-launch-desktop", LOG_PID, LOG_USER);
+      syslog (priority, "%s", message);
+      closelog ();
+    }
+  else
+    {
+      fprintf (stderr, "gio-launch-desktop[%d]: %s\n", getpid (), message);
+    }
+}
+
+/* The request for the scope, which the reply to it, the end of its job and
+ * the time limit update. */
+typedef struct
+{
+  const char *unit;
+  char *reason;  /* (owned) (nullable) why systemd will not move this process */
+  gboolean exists;  /* another request created the scope first */
+  gboolean job_done;  /* the job starting the scope ended as done */
+  gboolean timed_out;
+} ScopeRequest;
+
+static void
+job_removed_cb (GDBusConnection *connection,
+                const gchar     *sender_name,
+                const gchar     *object_path,
+                const gchar     *interface_name,
+                const gchar     *signal_name,
+                GVariant        *parameters,
+                gpointer         user_data)
+{
+  ScopeRequest *request = user_data;
+  const gchar *unit;
+  const gchar *result;
+
+  if (!g_variant_is_of_type (parameters, G_VARIANT_TYPE ("(uoss)")))
+    return;
+
+  g_variant_get (parameters, "(uo&s&s)", NULL, NULL, &unit, &result);
+  if (strcmp (unit, request->unit) != 0)
+    return;
+
+  /* systemd moves the process into the scope before the job starting it is
+   * done. With any other result, the process is not moved. */
+  if (strcmp (result, "done") == 0)
+    request->job_done = TRUE;
+  else if (request->reason == NULL)
+    request->reason = g_strdup_printf ("the job starting the scope ended with result %s", result);
+}
+
+static void
+start_transient_unit_cb (GObject      *source,
+                         GAsyncResult *result,
+                         gpointer      user_data)
+{
+  ScopeRequest *request = user_data;
+  GVariant *reply;
+  GError *error = NULL;
+  gchar *remote_error;
+
+  reply = g_dbus_connection_call_with_unix_fd_list_finish (G_DBUS_CONNECTION (source), NULL, result, &error);
+  if (reply != NULL)
+    {
+      /* systemd queued the job to start the scope, whose end follows as
+       * JobRemoved. */
+      g_variant_unref (reply);
+      return;
+    }
+
+  remote_error = g_dbus_error_get_remote_error (error);
+  if (g_strcmp0 (remote_error, "org.freedesktop.systemd1.UnitExists") == 0)
+    {
+      /* The launching process asked for the scope of this process first, as
+       * gnome-desktop's gnome_start_systemd_scope() does after launching, and
+       * systemd moves the process for that request. */
+      request->exists = TRUE;
+    }
+  else if (request->reason == NULL)
+    {
+      g_dbus_error_strip_remote_error (error);
+      if (remote_error != NULL)
+        request->reason = g_strdup_printf ("%s (%s)", error->message, remote_error);
+      else
+        request->reason = g_strdup_printf ("%s (%s error %d)", error->message,
+                                           g_quark_to_string (error->domain), error->code);
+    }
+
+  g_free (remote_error);
+  g_error_free (error);
+}
+
+static gboolean
+scope_timeout_cb (gpointer user_data)
+{
+  ScopeRequest *request = user_data;
+
+  request->timed_out = TRUE;
+
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+scope_poll_cb (gpointer user_data)
+{
+  return G_SOURCE_CONTINUE;
+}
+
+/*
+ * request_scope:
+ * @unit: name of the scope
+ * @description: description of the scope
+ * @application: the application, for the messages
+ *
+ * Asks systemd on the session bus to create the scope @unit for this
+ * process, and returns once this process is in it, or once it will not be,
+ * which is logged as an error, unless systemd refused because it is stopping,
+ * at the end of a session, which is logged as a notice.
+ */
+static void
+request_scope (const char *unit,
+               const char *description,
+               const char *application)
+{
+  GMainContext *context;
+  GDBusConnection *connection = NULL;
+  ScopeRequest request = { unit, NULL, FALSE, FALSE, FALSE };
+  GVariantBuilder builder;
+  GUnixFDList *fd_list = NULL;
+  GSource *timeout_source;
+  GSource *poll_source;
+  GError *error = NULL;
+  gchar *address;
+  guint subscription_id = 0;
+  int pidfd = -1;
+
+  /* The callbacks run while this function iterates the context below. */
+  context = g_main_context_new ();
+  g_main_context_push_thread_default (context);
+
+  /* A connection of its own, as the shared one ends the process when the bus
+   * goes away. */
+  address = g_dbus_address_get_for_bus_sync (G_BUS_TYPE_SESSION, NULL, &error);
+  if (address != NULL)
+    connection = g_dbus_connection_new_for_address_sync (address,
+                                                         G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                                         G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+                                                         NULL, NULL, &error);
+  g_free (address);
+  if (connection == NULL)
+    {
+      log_message (LOG_ERR, "Could not connect to the session bus to create scope %s, running %s outside of it: %s",
+                   unit, application, error->message);
+      g_error_free (error);
+      goto out;
+    }
+
+  /* Subscribed before the request is sent, so that the end of its job cannot
+   * be missed. systemd sends JobRemoved to the client which asked for the
+   * job, also when that client did not subscribe to systemd's signals. */
+  subscription_id = g_dbus_connection_signal_subscribe (connection,
+                                                        "org.freedesktop.systemd1",
+                                                        "org.freedesktop.systemd1.Manager",
+                                                        "JobRemoved",
+                                                        "/org/freedesktop/systemd1",
+                                                        NULL,
+                                                        G_DBUS_SIGNAL_FLAGS_NONE,
+                                                        job_removed_cb,
+                                                        &request,
+                                                        NULL);
+
+  /* The application's name need not be UTF-8, as for a command line it can
+   * be the file name of its program. */
+  if (description == NULL || !g_utf8_validate (description, -1, NULL))
+    description = unit;
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("(ssa(sv)a(sa(sv)))"));
+  g_variant_builder_add (&builder, "s", unit);
+  g_variant_builder_add (&builder, "s", "fail");
+
+  g_variant_builder_open (&builder, G_VARIANT_TYPE ("a(sv)"));
+  g_variant_builder_add (&builder, "(sv)", "Description", g_variant_new_string (description));
+  /* A process ID is resolved by systemd in its own PID namespace, which need
+   * not be the one of this process, like in a sandbox which shares the session
+   * bus. A pidfd names the process wherever it is, and the bus has to be able
+   * to pass it. */
+#ifdef SYS_pidfd_open
+  if (g_dbus_connection_get_capabilities (connection) & G_DBUS_CAPABILITY_FLAGS_UNIX_FD_PASSING)
+    pidfd = (int) syscall (SYS_pidfd_open, getpid (), 0);
+#endif
+  if (pidfd >= 0)
+    {
+      fd_list = g_unix_fd_list_new_from_array (&pidfd, 1);
+      g_variant_builder_add (&builder, "(sv)", "PIDFDs", g_variant_new_parsed ("[%h]", (gint32) 0));
+    }
+  else
+    {
+      guint32 pid = (guint32) getpid ();
+
+      g_variant_builder_add (&builder, "(sv)", "PIDs",
+                             g_variant_new_fixed_array (G_VARIANT_TYPE_UINT32, &pid, 1, sizeof (guint32)));
+    }
+  /* Let systemd remove the scope of an application which failed. */
+  g_variant_builder_add (&builder, "(sv)", "CollectMode", g_variant_new_string ("inactive-or-failed"));
+  g_variant_builder_close (&builder);
+
+  g_variant_builder_open (&builder, G_VARIANT_TYPE ("a(sa(sv))"));
+  g_variant_builder_close (&builder);
+
+  /* This process stays connected until systemd answered, which systemd
+   * requires, as it checks the caller on the bus before it acts on the
+   * request. */
+  g_dbus_connection_call_with_unix_fd_list (connection,
+                                            "org.freedesktop.systemd1",
+                                            "/org/freedesktop/systemd1",
+                                            "org.freedesktop.systemd1.Manager",
+                                            "StartTransientUnit",
+                                            g_variant_builder_end (&builder),
+                                            G_VARIANT_TYPE ("(o)"),
+                                            G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                            G_MAXINT,
+                                            fd_list,
+                                            NULL,
+                                            start_transient_unit_cb,
+                                            &request);
+  g_clear_object (&fd_list);
+
+  timeout_source = g_timeout_source_new (SCOPE_TIMEOUT_MS);
+  g_source_set_callback (timeout_source, scope_timeout_cb, &request, NULL);
+  g_source_attach (timeout_source, context);
+  /* systemd moves the process before it answers a request of another
+   * process, of which this one learns nothing, so the cgroup is checked
+   * regularly. */
+  poll_source = g_timeout_source_new (SCOPE_POLL_MS);
+  g_source_set_callback (poll_source, scope_poll_cb, NULL, NULL);
+  g_source_attach (poll_source, context);
+
+  for (;;)
+    {
+      if (is_in_unit (unit))
+        break;
+
+      if (request.reason != NULL)
+        {
+          /* systemd refuses to start any unit while it is stopping, at the end
+           * of a session, which is expected then and no error. */
+          log_message (strstr (request.reason, "(org.freedesktop.systemd1.TransactionIsDestructive)") != NULL ? LOG_NOTICE : LOG_ERR,
+                       "systemd did not create scope %s, running %s outside of it: %s",
+                       unit, application, request.reason);
+          break;
+        }
+
+      if (request.job_done)
+        {
+          log_message (LOG_ERR, "systemd started scope %s without this process, running %s outside of it",
+                       unit, application);
+          break;
+        }
+
+      if (request.timed_out)
+        {
+          log_message (LOG_ERR, "Scope %s did not exist after %d seconds, running %s outside of it",
+                       unit, SCOPE_TIMEOUT_MS / 1000, application);
+          break;
+        }
+
+      g_main_context_iteration (context, TRUE);
+    }
+
+  g_source_destroy (poll_source);
+  g_source_unref (poll_source);
+  g_source_destroy (timeout_source);
+  g_source_unref (timeout_source);
+
+out:
+  if (subscription_id != 0)
+    g_dbus_connection_signal_unsubscribe (connection, subscription_id);
+  if (connection != NULL)
+    {
+      g_dbus_connection_close_sync (connection, NULL, NULL);
+      g_object_unref (connection);
+    }
+  g_free (request.reason);
+
+  g_main_context_pop_thread_default (context);
+  g_main_context_unref (context);
+}
