+/* Runs gio-launch-desktop against a fake systemd in @mode, which does not
+ * create the scope, and checks that gio-launch-desktop itself asked for it,
+ * ran the application without waiting any longer, hid the variables from it,
+ * and logged @reason. */
+static void
+check_launch_desktop_scope_not_created (FakeSystemdMode  mode,
+                                        const gchar     *reason)
+{
+  GTestDBus *bus;
+  FakeSystemd *fake;
+  int output_fd;
+  int error_fd;
+  GPid pid;
+  gchar buf[100] = { 0 };
+  gchar err[1024] = { 0 };
+  gchar *expected;
+  gssize len;
+  int status;
+
+  bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+  g_test_dbus_up (bus);
+  fake = fake_systemd_start (mode);
+
+  if (!spawn_launch_desktop_with_scope (&output_fd, &error_fd, &pid))
+    goto out;
+
+  /* gio-launch-desktop stays connected until systemd answered, as systemd
+   * checks the caller on the bus before it acts on a request. */
+  g_assert_cmpuint (fake_systemd_wait_for_caller (fake), ==, (guint32) pid);
+
+  /* Well below the time gio-launch-desktop waits for a scope at most. */
+  g_assert_true (output_ready (output_fd, 5000));
+  len = read (output_fd, buf, sizeof (buf) - 1);
+  g_assert_cmpint (len, >, 0);
+  g_assert_cmpstr (buf, ==, "unset unset\n");
+
+  g_assert_cmpint (waitpid (pid, &status, 0), ==, pid);
+  g_assert_true (WIFEXITED (status) && WEXITSTATUS (status) == 0);
+
+  len = read (error_fd, err, sizeof (err) - 1);
+  g_assert_cmpint (len, >, 0);
+  expected = g_strdup_printf ("gio-launch-desktop[%d]: systemd did not create scope "
+                              "app-glib-test-%d.scope, running the application "
+                              "outside of it: %s\n",
+                              (int) pid, (int) pid, reason);
+  g_assert_cmpstr (err, ==, expected);
+  g_free (expected);
+
+  g_close (output_fd, NULL);
+  g_close (error_fd, NULL);
+
+out:
+  fake_systemd_stop (fake);
+  g_test_dbus_down (bus);
+  g_object_unref (bus);
+}
+
+static void
+test_launch_desktop_scope_refused (void)
+{
+  g_test_summary ("gio-launch-desktop asks systemd for the scope itself, and "
+                  "runs the application at once when systemd refuses it");
+
+  check_launch_desktop_scope_not_created (FAKE_SYSTEMD_REFUSE,
+                                          "Refused by the test (org.freedesktop.DBus.Error.AccessDenied)");
+}
+
+static void
+test_launch_desktop_scope_job_failed (void)
+{
+  g_test_summary ("gio-launch-desktop asks systemd for the scope itself, and "
+                  "runs the application at once when the job starting the "
+                  "scope fails");
+
+  check_launch_desktop_scope_not_created (FAKE_SYSTEMD_FAIL_JOB,
+                                          "the job starting the scope ended with result failed");
+}
+
+static void
+test_launch_desktop_scope_pending (void)
+{
+  GTestDBus *bus;
+  FakeSystemd *fake;
+  int output_fd;
+  int error_fd;
+  GPid pid;
+  int status;
+
+  g_test_summary ("gio-launch-desktop keeps waiting while systemd has not "
+                  "started the scope it asked for");
